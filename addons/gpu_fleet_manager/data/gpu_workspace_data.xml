    <!-- Standard Failover Service Combos -->
    <record id="combo_thapsang_s2v" model="gpu.service.combo">
        <field name="name">Thapsang Wan 2.2 S2V Failover</field>
        <field name="code">thapsang-s2v</field>
        <field name="service_type">video_wan22</field>
        <field name="routing_strategy">failover</field>
        <field name="timeout_seconds">30.0</field>
        <field name="max_retries">3</field>
        <field name="description">Automatic fallback from primary Thapsang Sovereign AI engine to Modal cloud fleet</field>
    </record>

    <record id="combo_line_thapsang_s2v_1" model="gpu.service.combo.line">
        <field name="combo_id" ref="combo_thapsang_s2v"/>
        <field name="sequence">10</field>
        <field name="target_model">thapsang/wan2.2-s2v</field>
        <field name="provider_id" ref="provider_thapsang"/>
        <field name="endpoint">/v1/videos/generations</field>
        <field name="weight">1</field>
