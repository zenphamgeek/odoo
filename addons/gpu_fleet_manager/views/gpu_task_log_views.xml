<?xml version="1.0" encoding="utf-8"?>
<data>
    <!-- GPU Task Log List View -->
    <record id="view_gpu_task_log_list" model="ir.ui.view">
        <field name="name">gpu.task.log.list</field>
        <field name="model">gpu.task.log</field>
        <field name="arch" type="xml">
            <list string="GPU Task Logs" decoration-danger="status == 'failed'" decoration-warning="status == 'quarantined'" decoration-success="status == 'completed'">
                <field name="execution_timestamp"/>
                <field name="request_id"/>
                <field name="endpoint"/>
                <field name="model_template"/>
                <field name="workspace_id"/>
                <field name="worker_id"/>
                <field name="duration_seconds"/>
                <field name="micro_cost"/>
                <field name="status" widget="badge" decoration-success="status == 'completed'" decoration-danger="status == 'failed'" decoration-warning="status == 'quarantined'" decoration-info="status == 'running'"/>
            </list>
        </field>
    </record>

    <!-- GPU Task Log Form View -->
    <record id="view_gpu_task_log_form" model="ir.ui.view">
        <field name="name">gpu.task.log.form</field>
        <field name="model">gpu.task.log</field>
        <field name="arch" type="xml">
            <form string="GPU Task Log">
                <header>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="request_id" placeholder="Request ID"/></h1>
                    </div>
                    <group>
                        <group string="Execution Specification">
                            <field name="endpoint"/>
                            <field name="model_template"/>
                            <field name="workspace_id"/>
                            <field name="worker_id"/>
                        </group>
                        <group string="Telemetry &amp; Cost">
                            <field name="duration_seconds"/>
                            <field name="micro_cost"/>
                            <field name="execution_timestamp"/>
                        </group>
                    </group>
                    <group string="Diagnostics" invisible="not error_message">
                        <field name="error_message" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- GPU Task Log Search View -->
    <record id="view_gpu_task_log_search" model="ir.ui.view">
        <field name="name">gpu.task.log.search</field>
        <field name="model">gpu.task.log</field>
        <field name="arch" type="xml">
            <search string="Search Task Logs">
                <field name="request_id"/>
                <field name="workspace_id"/>
                <field name="model_template"/>
                <field name="worker_id"/>
                <filter string="Completed" name="completed" domain="[('status', '=', 'completed')]"/>
                <filter string="Failed" name="failed" domain="[('status', '=', 'failed')]"/>
                <filter string="In-Flight" name="running" domain="[('status', '=', 'running')]"/>
                <group>
                    <filter string="Workspace" name="group_workspace" context="{'group_by': 'workspace_id'}"/>
                    <filter string="Model / Template" name="group_template" context="{'group_by': 'model_template'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- GPU Task Log Window Action -->
    <record id="action_gpu_task_log" model="ir.actions.act_window">
        <field name="name">Task Logs</field>
        <field name="res_model">gpu.task.log</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Inspect real-time GPU task execution logs and micro-costs
            </p>
        </field>
    </record>
</data>
