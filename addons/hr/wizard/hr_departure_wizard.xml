<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_departure_wizard_view_form" model="ir.ui.view">
        <field name="name">hr.departure.wizard.view.form</field>
        <field name="model">hr.departure.wizard</field>
        <field name="arch" type="xml">
            <form string="Register Departure">
                <group>
                    <field name="employee_ids" widget="many2many_tags"/>
                    <field name="departure_reason_id"/>
                    <field name="departure_date"/>
                    <div id="activities_label">
                        <label for="archive_private_address" string="Activities"/>
                    </div>
                    <div id="activities">
                        <field name="archive_private_address"/>
                    </div>
                </group>
                <footer>
                    <button name="action_register_departure" string="Apply" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
