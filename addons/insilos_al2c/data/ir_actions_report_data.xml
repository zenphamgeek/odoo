<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- =====================================================================
         AL2C ENTERPRISE SALES DOCUMENT REPORT ACTIONS (R3)
         Architecture: IBM Carbon Design Language & SAP Fiori Horizon Standards
         Statutory: Decree 123/2020/ND-CP, Decree 70/2025/ND-CP & Decree 13/2023/ND-CP
         ===================================================================== -->

    <!-- 1. Executive Sales Proposal (Bản Đề Xuất Giải Pháp) -->
    <record id="action_report_sales_proposal" model="ir.actions.report">
        <field name="name">Bản Đề Xuất Giải Pháp (Executive Proposal)</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">insilos_al2c.report_sales_proposal</field>
        <field name="report_file">insilos_al2c.report_sales_proposal</field>
        <field name="print_report_name">'De_Xuat_Giai_Phap_' + (object.name or '').replace('/', '_')</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="group_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <!-- 2. Official Commercial Quotation (Báo Giá Thương Mại) -->
    <record id="action_report_commercial_quotation" model="ir.actions.report">
        <field name="name">Báo Giá Thương Mại (Commercial Quotation)</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">insilos_al2c.report_commercial_quotation</field>
        <field name="report_file">insilos_al2c.report_commercial_quotation</field>
        <field name="print_report_name">'Bao_Gia_' + (object.name or '').replace('/', '_')</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="group_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <!-- 3. Statement of Work SOW (Phụ Lục Phạm Vi Công Việc) -->
    <record id="action_report_statement_of_work" model="ir.actions.report">
        <field name="name">Phụ Lục SOW (Statement of Work)</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">insilos_al2c.report_statement_of_work</field>
        <field name="report_file">insilos_al2c.report_statement_of_work</field>
        <field name="print_report_name">'SOW_' + (object.name or '').replace('/', '_')</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="group_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <!-- 4. SLA & Managed Services Contract (Hợp Đồng Cam Kết Mức Dịch Vụ) -->
    <record id="action_report_sla_contract" model="ir.actions.report">
        <field name="name">Hợp Đồng SLA (Service Level Agreement)</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">insilos_al2c.report_sla_contract</field>
        <field name="report_file">insilos_al2c.report_sla_contract</field>
        <field name="print_report_name">'SLA_' + (object.name or '').replace('/', '_')</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="group_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>
</odoo>
