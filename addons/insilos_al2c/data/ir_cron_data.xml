<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_al2c_reindex_knowledge" model="ir.cron">
        <field name="name">AL2C: Auto-Reindex KMS Knowledge Articles into RAG Chunks</field>
        <field name="model_id" ref="model_al2c_rag_service"/>
        <field name="state">code</field>
        <field name="code">model.cron_reindex_knowledge_articles()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_al2c_process_pinned_conversions" model="ir.cron">
        <field name="name">AL2C: Process Pinned Timesheet Conversions into Decree 70 Invoices</field>
        <field name="model_id" ref="model_al2c_timesheet_staging"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_pinned_conversions()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
