<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <!-- =====================================================================
         INNORIA PUBLIC AI CONCIERGE & SOFTWARE SERVICES CONFIGURATOR (OWL 2)
         Platform: Innoria Enterprise / Insilos AL2C
         Design: Enterprise Design System & Sovereign Horizon Standards
         Architecture: OWL 2 Reactive Component, Grounded KMS, Zero Bare White
         ===================================================================== -->
    <t t-name="innoria.ai_concierge_widget">
        <div class="al2c-concierge-root">
            <!-- 0. Proactive Context Nudge Pill -->
            <t t-if="!state.isOpen and state.proactiveNudgeVisible">
                <div
                    class="al2c-proactive-nudge"
                    role="button"
                    tabindex="0"
                    t-on-click="this.openFromProactiveNudge"
                    title="Khám phá Dịch vụ Phần mềm &amp; Dự toán tự động"
                >
                    <span class="al2c-nudge-badge">AI Dự Toán</span>
                    <span class="al2c-nudge-text" t-esc="state.proactiveNudgeText"/>
                    <button
                        type="button"
                        class="al2c-nudge-dismiss"
                        t-on-click="(ev) => this.dismissProactiveNudge(ev)"
                        title="Đóng gợi ý"
                        aria-label="Đóng gợi ý"
                    >
                        <i class="fa fa-times" aria-hidden="true"/>
                    </button>
                </div>
            </t>

            <!-- 1. Floating Action Launcher Button -->
            <button
                type="button"
                class="al2c-concierge-launcher"
                t-att-class="{'is-active': state.isOpen}"
                t-on-click="this.toggleDrawer"
                title="Trợ Lý AI &amp; Dự Toán Dịch Vụ Phần Mềm Innoria"
                aria-label="Trợ Lý AI &amp; Dự Toán Dịch Vụ Phần Mềm Innoria"
            >
                <div class="al2c-launcher-content">
                    <t t-if="state.isOpen">
                        <i class="fa fa-times al2c-launcher-icon-close" aria-hidden="true"/>
                    </t>
                    <t t-else="">
                        <img
                            src="/insilos_al2c/static/src/img/logo_innoria_header.svg"
                            alt="Innoria AI"
                            class="al2c-launcher-logo"
                        />
                        <span class="al2c-launcher-pulse" aria-hidden="true"/>
                    </t>
                </div>
            </button>

            <!-- 2. Chat & Services Configurator Drawer Container -->
            <div
                class="al2c-concierge-drawer"
                t-att-class="{'is-open': state.isOpen}"
                role="dialog"
                aria-labelledby="al2c-concierge-title"
                aria-modal="true"
            >
                <!-- Sovereign Horizon 3px Gradient Stripe -->
                <div class="al2c-horizon-stripe" aria-hidden="true"/>

                <!-- Drawer Header -->
                <header class="al2c-concierge-header">
                    <div class="al2c-header-brand">
                        <img
                            src="/insilos_al2c/static/src/img/logo_innoria_header.svg"
                            alt="Innoria Enterprise Logo"
                            class="al2c-header-logo"
                        />
                        <div class="al2c-header-meta">
                            <h6 id="al2c-concierge-title" class="al2c-header-title">Innoria AI Concierge</h6>
                            <div class="al2c-status-badge">
                                <span class="al2c-status-dot" aria-hidden="true"/>
                                <span class="al2c-status-text">Grounded RAG • Software &amp; ERP</span>
                            </div>
                        </div>
                    </div>

                    <div class="al2c-header-actions">
                        <t t-if="state.activeTab !== 'lead'">
                            <button
                                type="button"
                                class="btn al2c-btn-header-quote"
                                t-on-click="() => this.openLeadForm('all')"
                                title="Đăng ký tư vấn &amp; Báo giá dự toán"
                            >
                                <i class="fa fa-calendar-check-o me-1" aria-hidden="true"/>
                                <span>Báo Giá</span>
                            </button>
                        </t>
                        <t t-else="">
                            <button
                                type="button"
                                class="btn al2c-btn-header-quote"
                                t-on-click="this.closeLeadForm"
                                title="Quay lại hội thoại AI"
                            >
                                <i class="fa fa-comments me-1" aria-hidden="true"/>
                                <span>Hội Thoại</span>
                            </button>
                        </t>
                        <button
                            type="button"
                            class="btn al2c-btn-header-icon"
                            t-on-click="this.clearChat"
                            title="Làm mới cuộc trò chuyện"
                            aria-label="Làm mới cuộc trò chuyện"
                        >
                            <i class="fa fa-refresh" aria-hidden="true"/>
                        </button>
                        <button
                            type="button"
                            class="btn al2c-btn-header-icon"
                            t-on-click="this.toggleDrawer"
                            title="Thu nhỏ cửa sổ"
                            aria-label="Thu nhỏ cửa sổ"
                        >
                            <i class="fa fa-times" aria-hidden="true"/>
                        </button>
                    </div>
                </header>

                <!-- 3-Tab Interactive Navigation Bar -->
                <nav class="al2c-concierge-tabs" role="tablist" aria-label="Điều hướng AI Concierge">
                    <button
                        type="button"
                        role="tab"
                        class="al2c-tab-btn"
                        t-att-class="{'is-active': state.activeTab === 'chat'}"
                        t-att-aria-selected="state.activeTab === 'chat' ? 'true' : 'false'"
                        t-on-click="() => this.setActiveTab('chat')"
                    >
                        <span>💬 Hội Thoại AI</span>
                    </button>
                    <button
                        type="button"
                        role="tab"
                        class="al2c-tab-btn"
                        t-att-class="{'is-active': state.activeTab === 'services'}"
                        t-att-aria-selected="state.activeTab === 'services' ? 'true' : 'false'"
                        t-on-click="() => this.setActiveTab('services')"
                    >
                        <span>🧮 Dịch Vụ &amp; Dự Toán</span>
                    </button>
                    <button
                        type="button"
                        role="tab"
                        class="al2c-tab-btn"
                        t-att-class="{'is-active': state.activeTab === 'lead'}"
                        t-att-aria-selected="state.activeTab === 'lead' ? 'true' : 'false'"
                        t-on-click="() => this.setActiveTab('lead')"
                    >
                        <span>📅 Nhận Báo Giá</span>
                    </button>
                </nav>

                <!-- =========================================================
                     TAB 3: LEAD CAPTURE FORM SECTION ('lead')
                     ========================================================= -->
                <t t-if="state.activeTab === 'lead' or state.showLeadForm">
                    <section class="al2c-lead-section">
                        <div class="al2c-lead-header">
                            <div class="d-flex align-items-center gap-2">
                                <button
                                    type="button"
                                    class="btn al2c-btn-back"
                                    t-on-click="this.closeLeadForm"
                                    title="Quay lại"
                                    aria-label="Quay lại"
                                >
                                    <i class="fa fa-arrow-left" aria-hidden="true"/>
                                </button>
                                <div>
                                    <h5 class="al2c-lead-title mb-0">Đăng Ký Tư Vấn &amp; Nhận Báo Giá</h5>
                                    <p class="al2c-lead-subtitle mb-0">Solution Architect sẽ gửi hồ sơ dự toán chi tiết trong 24 giờ</p>
                                </div>
                            </div>
                        </div>

                        <div class="al2c-lead-body">
                            <!-- Configured Service & Estimate Summary Banner -->
                            <t t-if="state.configurator and state.configurator.estimate">
                                <div class="al2c-lead-config-banner">
                                    <div class="al2c-lead-config-info">
                                        <div class="al2c-lead-config-label">Cấu hình dịch vụ đã chọn:</div>
                                        <div class="al2c-lead-config-title" t-esc="state.configurator.estimate.service_name"/>
                                        <div class="al2c-lead-config-meta">
                                            <span t-esc="state.configurator.estimate.scale_label"/>
                                            <span> • </span>
                                            <span t-esc="state.configurator.units"/>
                                            <span> </span>
                                            <span t-esc="state.configurator.estimate.unit_label"/>
                                            <span> • </span>
                                            <span t-esc="state.configurator.duration_months"/>
                                            <span> tháng</span>
                                        </div>
                                        <div class="al2c-lead-config-price">
                                            <span>Dự toán sơ bộ: </span>
                                            <strong t-esc="state.configurator.estimate.formatted_total_vnd"/>
                                        </div>
                                    </div>
                                    <button
                                        type="button"
                                        class="btn al2c-btn-edit-config"
                                        t-on-click="() => this.setActiveTab('services')"
                                    >
                                        <i class="fa fa-sliders me-1" aria-hidden="true"/>
                                        <span>Chỉnh sửa</span>
                                    </button>
                                </div>
                            </t>

                            <!-- Success Banner -->
                            <t t-if="state.leadSuccessMessage">
                                <div class="alert al2c-alert-success d-flex align-items-center gap-2" role="alert">
                                    <i class="fa fa-check-circle fs-5" aria-hidden="true"/>
                                    <div>
                                        <div class="fw-semibold">Gửi yêu cầu thành công!</div>
                                        <div class="small" t-esc="state.leadSuccessMessage"/>
                                    </div>
                                </div>
                            </t>

                            <!-- Error Banner -->
                            <t t-if="state.leadErrorMessage">
                                <div class="alert al2c-alert-danger d-flex align-items-center gap-2" role="alert">
                                    <i class="fa fa-exclamation-triangle" aria-hidden="true"/>
                                    <div class="small" t-esc="state.leadErrorMessage"/>
                                </div>
                            </t>

                            <form class="al2c-lead-form" t-on-submit.prevent="this.submitLeadForm">
                                <div class="al2c-form-group">
                                    <label class="al2c-form-label" for="al2c_lead_name">Họ và tên <span class="text-danger">*</span></label>
                                    <input
                                        type="text"
                                        id="al2c_lead_name"
                                        class="form-control al2c-form-input"
                                        placeholder="Nguyễn Văn A"
                                        t-att-value="state.leadForm.name"
                                        t-on-input="(ev) => this.updateLeadField('name', ev)"
                                        required="required"
                                    />
                                </div>

                                <div class="al2c-form-row">
                                    <div class="al2c-form-group">
                                        <label class="al2c-form-label" for="al2c_lead_email">Email doanh nghiệp <span class="text-danger">*</span></label>
                                        <input
                                            type="email"
                                            id="al2c_lead_email"
                                            class="form-control al2c-form-input"
                                            placeholder="a.nguyen@company.com"
                                            t-att-value="state.leadForm.email"
                                            t-on-input="(ev) => this.updateLeadField('email', ev)"
                                        />
                                    </div>
                                    <div class="al2c-form-group">
                                        <label class="al2c-form-label" for="al2c_lead_phone">Số điện thoại <span class="text-danger">*</span></label>
                                        <input
                                            type="tel"
                                            id="al2c_lead_phone"
                                            class="form-control al2c-form-input"
                                            placeholder="0912 345 678"
                                            t-att-value="state.leadForm.phone"
                                            t-on-input="(ev) => this.updateLeadField('phone', ev)"
                                        />
                                    </div>
                                </div>

                                <div class="al2c-form-row">
                                    <div class="al2c-form-group">
                                        <label class="al2c-form-label" for="al2c_lead_company">Tên công ty / Tổ chức <span class="text-danger">*</span></label>
                                        <input
                                            type="text"
                                            id="al2c_lead_company"
                                            class="form-control al2c-form-input"
                                            placeholder="Công ty Cổ phần ABC"
                                            t-att-value="state.leadForm.company_name"
                                            t-on-input="(ev) => this.updateLeadField('company_name', ev)"
                                            required="required"
                                        />
                                    </div>
                                    <div class="al2c-form-group">
                                        <label class="al2c-form-label" for="al2c_lead_scale">Quy mô nhân sự</label>
                                        <select
                                            id="al2c_lead_scale"
                                            class="form-select al2c-form-input"
                                            t-att-value="state.leadForm.employee_count"
                                            t-on-change="(ev) => this.updateLeadField('employee_count', ev)"
                                        >
                                            <option value="Dưới 50 nhân sự">Dưới 50 nhân sự (SME)</option>
                                            <option value="50 - 200 nhân sự">50 - 200 nhân sự (Mid-market)</option>
                                            <option value="200 - 500 nhân sự">200 - 500 nhân sự (Doanh nghiệp lớn)</option>
                                            <option value="Trên 500 nhân sự">Trên 500 nhân sự (Enterprise / Tập đoàn)</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="al2c-form-group">
                                    <label class="al2c-form-label" for="al2c_lead_solution">Dịch vụ &amp; Giải pháp quan tâm</label>
                                    <select
                                        id="al2c_lead_solution"
                                        class="form-select al2c-form-input"
                                        t-att-value="state.leadForm.product_interest"
                                        t-on-change="(ev) => this.updateLeadField('product_interest', ev)"
                                    >
                                        <option value="Squad Kỹ Sư Đồng Phát Triển (Dedicated Co-Dev Squad - TT 13/2020)">Squad Kỹ Sư Đồng Phát Triển (Co-Dev Squad - TT 13/2020)</option>
                                        <option value="Phát Triển Phần Mềm Trọn Gói (Turnkey Custom Software - 5-Gate Enterprise)">Phát Triển Phần Mềm Trọn Gói (Turnkey Software - 5-Gate Enterprise)</option>
                                        <option value="Insilos ERP (VAS &amp; Hóa đơn ĐT Nghị định 70/2025)">Insilos ERP (VAS &amp; Hóa đơn ĐT 70/2025)</option>
                                        <option value="Vertical Resilience (GRC, ISO 27001 &amp; PDPD 13/2023)">Vertical Resilience (GRC, ISO 27701 &amp; PDPD 13/2023)</option>
                                        <option value="Mojo AI (Tác tử AL2C &amp; Bóc tách thông minh)">Mojo AI (Tác tử AL2C &amp; Bóc tách thông minh)</option>
                                        <option value="Zencode Ent (Hiện đại hóa mã kế thừa &amp; AGY Fleet)">Zencode Ent (Hiện đại hóa mã kế thừa &amp; AGY Fleet)</option>
                                        <option value="Hệ sinh thái Tứ Trụ Toàn Diện (ERP + GRC + AI + Zencode)">Hệ sinh thái Tứ Trụ Toàn Diện</option>
                                    </select>
                                </div>

                                <div class="al2c-form-group">
                                    <label class="al2c-form-label" for="al2c_lead_notes">Yêu cầu kỹ thuật, phạm vi tích hợp hoặc lộ trình dự kiến</label>
                                    <textarea
                                        id="al2c_lead_notes"
                                        class="form-control al2c-form-input"
                                        rows="3"
                                        placeholder="Mô tả sơ lược quy trình, số lượng kỹ sư/người dùng hoặc thời gian Go-Live mong muốn..."
                                        t-att-value="state.leadForm.notes"
                                        t-on-input="(ev) => this.updateLeadField('notes', ev)"
                                    />
                                </div>

                                <div class="al2c-lead-actions">
                                    <button
                                        type="submit"
                                        class="btn al2c-btn-primary"
                                        t-att-disabled="state.isLoading"
                                    >
                                        <t t-if="state.isLoading">
                                            <i class="fa fa-spinner fa-spin me-2" aria-hidden="true"/>
                                            <span>Đang khởi tạo hồ sơ...</span>
                                        </t>
                                        <t t-else="">
                                            <i class="fa fa-paper-plane me-2" aria-hidden="true"/>
                                            <span>Gửi Yêu Cầu Khảo Sát &amp; Báo Giá Chính Thức</span>
                                        </t>
                                    </button>
                                    <button
                                        type="button"
                                        class="btn al2c-btn-secondary"
                                        t-on-click="this.closeLeadForm"
                                    >
                                        Quay lại hội thoại AI
                                    </button>
                                </div>
                            </form>
                        </div>
                    </section>
                </t>

                <!-- =========================================================
                     TAB 2: INTERACTIVE SOFTWARE SERVICES CONFIGURATOR ('services')
                     ========================================================= -->
                <t t-elif="state.activeTab === 'services'">
                    <section class="al2c-configurator-section">
                        <!-- 1. 6-Service Selector Pills -->
                        <div class="al2c-cfg-block">
                            <div class="al2c-cfg-label">1. Chọn Dịch Vụ Phần Mềm &amp; Giải Pháp</div>
                            <div class="al2c-cfg-service-pills">
                                <t t-foreach="state.servicesCatalog" t-as="svc" t-key="svc.code">
                                    <button
                                        type="button"
                                        class="al2c-cfg-service-pill"
                                        t-att-class="{'is-selected': state.configurator.service_code === svc.code}"
                                        t-on-click="() => this.selectConfiguratorService(svc.code)"
                                    >
                                        <span t-esc="svc.short_label || svc.name"/>
                                    </button>
                                </t>
                            </div>
                        </div>

                        <!-- Selected Service Brief Card -->
                        <t t-set="currentService" t-value="this.currentConfigService"/>
                        <div class="al2c-cfg-service-overview">
                            <div class="d-flex align-items-center justify-content-between gap-2 mb-1">
                                <h6 class="al2c-cfg-service-title mb-0" t-esc="currentService.name"/>
                                <span class="al2c-cfg-service-badge" t-esc="currentService.badge"/>
                            </div>
                            <p class="al2c-cfg-service-desc mb-0" t-esc="currentService.summary"/>
                        </div>

                        <!-- 2. Scale Tier Selector -->
                        <div class="al2c-cfg-block">
                            <div class="al2c-cfg-label">2. Cấp Độ Kiến Trúc &amp; SLA (Scale Tier)</div>
                            <div class="al2c-cfg-tier-grid">
                                <button
                                    type="button"
                                    class="al2c-cfg-option-btn"
                                    t-att-class="{'is-selected': state.configurator.scale_tier === 'starter'}"
                                    t-on-click="() => this.setConfiguratorTier('starter')"
                                >
                                    Khởi đầu (Starter)
                                </button>
                                <button
                                    type="button"
                                    class="al2c-cfg-option-btn"
                                    t-att-class="{'is-selected': state.configurator.scale_tier === 'growth'}"
                                    t-on-click="() => this.setConfiguratorTier('growth')"
                                >
                                    Tăng trưởng (Growth)
                                </button>
                                <button
                                    type="button"
                                    class="al2c-cfg-option-btn"
                                    t-att-class="{'is-selected': state.configurator.scale_tier === 'enterprise'}"
                                    t-on-click="() => this.setConfiguratorTier('enterprise')"
                                >
                                    Tập đoàn (Enterprise)
                                </button>
                            </div>
                        </div>

                        <!-- 3. Units / Squad Size & Duration Controls -->
                        <div class="al2c-cfg-row">
                            <div class="al2c-cfg-block flex-grow-1">
                                <div class="al2c-cfg-label">
                                    <span>3. Quy mô: </span>
                                    <strong t-esc="currentService.unit_label"/>
                                </div>
                                <div class="al2c-cfg-units-row">
                                    <div class="al2c-cfg-unit-pills">
                                        <t t-foreach="currentService.unit_options" t-as="uOpt" t-key="uOpt">
                                            <button
                                                type="button"
                                                class="al2c-cfg-unit-pill"
                                                t-att-class="{'is-selected': state.configurator.units === uOpt}"
                                                t-on-click="() => this.setConfiguratorUnits(uOpt)"
                                            >
                                                <t t-esc="uOpt"/>
                                            </button>
                                        </t>
                                    </div>
                                    <div class="al2c-cfg-stepper">
                                        <button
                                            type="button"
                                            class="al2c-stepper-btn"
                                            t-on-click="() => this.adjustConfiguratorUnits(-1)"
                                            aria-label="Giảm số lượng"
                                        >
                                            -
                                        </button>
                                        <span class="al2c-stepper-val" t-esc="state.configurator.units"/>
                                        <button
                                            type="button"
                                            class="al2c-stepper-btn"
                                            t-on-click="() => this.adjustConfiguratorUnits(1)"
                                            aria-label="Tăng số lượng"
                                        >
                                            +
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div class="al2c-cfg-block">
                                <div class="al2c-cfg-label">4. Thời Lượng Cam Kết</div>
                                <div class="al2c-cfg-duration-pills">
                                    <button
                                        type="button"
                                        class="al2c-cfg-option-btn"
                                        t-att-class="{'is-selected': state.configurator.duration_months === 3}"
                                        t-on-click="() => this.setConfiguratorDuration(3)"
                                    >
                                        3 tháng
                                    </button>
                                    <button
                                        type="button"
                                        class="al2c-cfg-option-btn"
                                        t-att-class="{'is-selected': state.configurator.duration_months === 6}"
                                        t-on-click="() => this.setConfiguratorDuration(6)"
                                    >
                                        6 tháng (-7%)
                                    </button>
                                    <button
                                        type="button"
                                        class="al2c-cfg-option-btn"
                                        t-att-class="{'is-selected': state.configurator.duration_months === 12}"
                                        t-on-click="() => this.setConfiguratorDuration(12)"
                                    >
                                        12 tháng (-15%)
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- 5. Live Estimate Display Card -->
                        <t t-set="est" t-value="state.configurator.estimate"/>
                        <div class="al2c-estimate-card">
                            <div class="al2c-estimate-header">
                                <div>
                                    <div class="al2c-estimate-caption">Tổng Dự Toán Đầu Tư (Tạm tính chưa VAT)</div>
                                    <div class="al2c-estimate-total" t-esc="est.formatted_total_vnd"/>
                                </div>
                                <div class="al2c-estimate-monthly-box">
                                    <div class="al2c-estimate-caption">Chi phí bình quân/tháng</div>
                                    <div class="al2c-estimate-monthly" t-esc="est.formatted_monthly_vnd"/>
                                </div>
                            </div>

                            <div class="al2c-estimate-details">
                                <div class="al2c-estimate-detail-group">
                                    <div class="al2c-estimate-detail-title">
                                        <i class="fa fa-credit-card me-1" aria-hidden="true"/>
                                        <span>Phương thức Nghiệm thu &amp; Thanh toán:</span>
                                    </div>
                                    <div class="al2c-estimate-detail-text" t-esc="est.payment_schedule"/>
                                </div>

                                <t t-if="est.lifecycle_steps and est.lifecycle_steps.length">
                                    <div class="al2c-estimate-detail-group">
                                        <div class="al2c-estimate-detail-title">
                                            <i class="fa fa-sitemap me-1" aria-hidden="true"/>
                                            <span>Quy trình Chuẩn (5-Gate Enterprise / TT 13/2020):</span>
                                        </div>
                                        <ul class="al2c-estimate-list">
                                            <t t-foreach="est.lifecycle_steps" t-as="step" t-key="step_index">
                                                <li t-esc="step"/>
                                            </t>
                                        </ul>
                                    </div>
                                </t>

                                <t t-if="est.compliance_guarantees and est.compliance_guarantees.length">
                                    <div class="al2c-estimate-detail-group">
                                        <div class="al2c-estimate-detail-title">
                                            <i class="fa fa-shield me-1" aria-hidden="true"/>
                                            <span>Cam kết Tuân thủ &amp; Bàn giao:</span>
                                        </div>
                                        <ul class="al2c-estimate-list">
                                            <t t-foreach="est.compliance_guarantees" t-as="guar" t-key="guar_index">
                                                <li t-esc="guar"/>
                                            </t>
                                        </ul>
                                    </div>
                                </t>
                            </div>

                            <div class="al2c-estimate-ctas">
                                <button
                                    type="button"
                                    class="btn al2c-btn-cfg-ask"
                                    t-on-click="this.askAiAboutCurrentConfig"
                                >
                                    <span>💬 Hỏi AI Chuyên Sâu Về Cấu Hình Này</span>
                                </button>
                                <button
                                    type="button"
                                    class="btn al2c-btn-cfg-proceed"
                                    t-on-click="this.proceedToLeadWithConfig"
                                >
                                    <span>🚀 Chốt Cấu Hình &amp; Nhận Báo Giá Chính Thức</span>
                                </button>
                            </div>
                        </div>
                    </section>
                </t>

                <!-- =========================================================
                     TAB 1: AI CONVERSATION VIEWPORT ('chat')
                     ========================================================= -->
                <t t-else="">
                    <div class="al2c-messages-viewport" t-ref="messagesContainer">
                        <t t-foreach="state.messages" t-as="msg" t-key="msg.id">
                            <div t-attf-class="al2c-message-row al2c-message-{{ msg.sender }}">
                                <!-- Assistant Message -->
                                <t t-if="msg.sender === 'assistant'">
                                    <div class="al2c-message-avatar" aria-hidden="true">
                                        <img
                                            src="/insilos_al2c/static/src/img/logo_innoria_header.svg"
                                            alt="Innoria AI Avatar"
                                            class="al2c-avatar-img"
                                        />
                                    </div>
                                    <div class="al2c-bubble-container">
                                        <div class="al2c-bubble al2c-bubble-assistant">
                                            <div class="al2c-bubble-content" t-out="msg.formattedText || msg.text"/>

                                            <!-- Interactive Software Service Cards -->
                                            <t t-if="msg.service_cards and msg.service_cards.length">
                                                <div class="al2c-service-cards-grid">
                                                    <t t-foreach="msg.service_cards" t-as="card" t-key="card.code">
                                                        <div class="al2c-service-card">
                                                            <div class="al2c-service-card-top">
                                                                <span class="al2c-service-card-badge" t-esc="card.badge"/>
                                                                <span class="al2c-service-card-price" t-esc="card.starting_price"/>
                                                            </div>
                                                            <div class="al2c-service-card-title" t-esc="card.name"/>
                                                            <div class="al2c-service-card-summary" t-esc="card.summary"/>
                                                            <div class="al2c-service-card-actions">
                                                                <button
                                                                    type="button"
                                                                    class="btn al2c-service-card-btn config"
                                                                    t-on-click="() => this.openServiceConfigurator(card.code)"
                                                                >
                                                                    <span>⚙️ Dự Toán &amp; Cấu Hình</span>
                                                                </button>
                                                                <button
                                                                    type="button"
                                                                    class="btn al2c-service-card-btn quote"
                                                                    t-on-click="() => this.openLeadFormForService(card.code)"
                                                                >
                                                                    <span>📅 Nhận Báo Giá Gói Này</span>
                                                                </button>
                                                            </div>
                                                        </div>
                                                    </t>
                                                </div>
                                            </t>

                                            <!-- Grounded Verification Badge -->
                                            <t t-if="msg.grounded">
                                                <div class="al2c-entailment-badge">
                                                    <i class="fa fa-shield me-1" aria-hidden="true"/>
                                                    <span>Grounded RAG • Điểm xác thực: </span>
                                                    <strong><t t-esc="(msg.entailment_score * 100).toFixed(0)"/>%</strong>
                                                </div>
                                            </t>

                                            <!-- Expandable Citation Chips -->
                                            <t t-if="msg.citations and msg.citations.length">
                                                <div class="al2c-citations-wrapper">
                                                    <button
                                                        type="button"
                                                        class="btn al2c-citations-toggle"
                                                        t-on-click="() => this.toggleCitations(msg)"
                                                        title="Bấm để xem các trích dẫn tài liệu quy chuẩn"
                                                    >
                                                        <i
                                                            t-attf-class="fa fa-caret-{{ msg.citationsExpanded ? 'down' : 'right' }} me-1"
                                                            aria-hidden="true"
                                                        />
                                                        <span>Trích dẫn kiểm chứng KMS (<t t-esc="msg.citations.length"/> nguồn)</span>
                                                    </button>
                                                    <t t-if="msg.citationsExpanded">
                                                        <div class="al2c-citations-list">
                                                            <t t-foreach="msg.citations" t-as="cit" t-key="cit_index">
                                                                <div class="al2c-citation-chip">
                                                                    <i class="fa fa-bookmark-o me-1" aria-hidden="true"/>
                                                                    <span class="al2c-citation-text" t-esc="cit"/>
                                                                </div>
                                                            </t>
                                                            <t t-if="msg.reason">
                                                                <div class="al2c-entailment-reason">
                                                                    <i class="fa fa-info-circle me-1" aria-hidden="true"/>
                                                                    <span t-esc="msg.reason"/>
                                                                </div>
                                                            </t>
                                                        </div>
                                                    </t>
                                                </div>
                                            </t>

                                            <!-- Suggested Action Buttons -->
                                            <t t-if="msg.suggested_actions and msg.suggested_actions.length">
                                                <div class="al2c-actions-container">
                                                    <t t-foreach="msg.suggested_actions" t-as="act" t-key="act_index">
                                                        <button
                                                            type="button"
                                                            class="btn al2c-action-chip"
                                                            t-on-click="() => this.onSuggestedActionClick(act)"
                                                        >
                                                            <i class="fa fa-arrow-circle-right me-1" aria-hidden="true"/>
                                                            <span t-esc="act.label"/>
                                                        </button>
                                                    </t>
                                                </div>
                                            </t>
                                        </div>
                                        <div class="al2c-message-time"><t t-esc="msg.time"/></div>
                                    </div>
                                </t>

                                <!-- User Message -->
                                <t t-else="">
                                    <div class="al2c-bubble-container user">
                                        <div class="al2c-bubble al2c-bubble-user">
                                            <div class="al2c-bubble-content" t-esc="msg.text"/>
                                        </div>
                                        <div class="al2c-message-time user"><t t-esc="msg.time"/></div>
                                    </div>
                                </t>
                            </div>
                        </t>

                        <!-- Typing Shimmer / Loading Indicator -->
                        <t t-if="state.isLoading">
                            <div class="al2c-typing-row">
                                <div class="al2c-message-avatar" aria-hidden="true">
                                    <img
                                        src="/insilos_al2c/static/src/img/logo_innoria_header.svg"
                                        alt="Innoria AI Avatar"
                                        class="al2c-avatar-img"
                                    />
                                </div>
                                <div class="al2c-typing-bubble">
                                    <div class="al2c-typing-dots">
                                        <span class="al2c-typing-dot"/>
                                        <span class="al2c-typing-dot"/>
                                        <span class="al2c-typing-dot"/>
                                    </div>
                                    <span class="al2c-typing-label">AI Concierge đang bóc tách ngữ nghĩa KMS...</span>
                                </div>
                            </div>
                        </t>
                    </div>

                    <!-- Quick Prompt Action Chips -->
                    <div class="al2c-quick-prompts-bar">
                        <div class="al2c-quick-label">
                            <i class="fa fa-bolt me-1" aria-hidden="true"/>
                            <span>Khám phá nhanh Dịch vụ Phần mềm &amp; Giải pháp:</span>
                        </div>
                        <div class="al2c-quick-chips-wrapper">
                            <button
                                type="button"
                                class="btn al2c-quick-chip"
                                t-on-click="() => this.sendQuickPrompt('👨‍💻 Thuê Squad Kỹ sư Đồng phát triển (TT 13/2020)')"
                            >
                                👨‍💻 Thuê Squad Kỹ sư Đồng phát triển (TT 13/2020)
                            </button>
                            <button
                                type="button"
                                class="btn al2c-quick-chip"
                                t-on-click="() => this.sendQuickPrompt('🏗️ Phát triển Phần mềm Trọn gói (Turnkey)')"
                            >
                                🏗️ Phát triển Phần mềm Trọn gói (Turnkey)
                            </button>
                            <button
                                type="button"
                                class="btn al2c-quick-chip"
                                t-on-click="() => this.sendQuickPrompt('📊 Báo giá Clean-Core ERP &amp; HĐĐT 1C26TAA')"
                            >
                                📊 Báo giá Clean-Core ERP &amp; HĐĐT 1C26TAA
                            </button>
                            <button
                                type="button"
                                class="btn al2c-quick-chip"
                                t-on-click="() => this.sendQuickPrompt('🛡️ Tuân thủ ISO 27701 / GRC / e-CO')"
                            >
                                🛡️ Tuân thủ ISO 27701 / GRC / e-CO
                            </button>
                        </div>
                    </div>

                    <!-- Input Footer -->
                    <footer class="al2c-concierge-footer">
                        <div class="al2c-input-wrapper">
                            <textarea
                                t-ref="queryInput"
                                class="form-control al2c-textarea"
                                placeholder="Hỏi về thuê Squad Kỹ sư, Phần mềm Trọn gói, ERP, GRC, AI..."
                                rows="1"
                                t-att-value="state.currentQuery"
                                t-on-input="this.updateQuery"
                                t-on-keydown="this.onInputKeyDown"
                                t-att-disabled="state.isLoading"
                                aria-label="Nội dung câu hỏi gửi AI Concierge"
                            />
                            <button
                                type="button"
                                class="btn al2c-btn-send"
                                t-on-click="this.sendMessage"
                                t-att-disabled="state.isLoading or !state.currentQuery.trim()"
                                title="Gửi câu hỏi (Enter)"
                                aria-label="Gửi câu hỏi"
                            >
                                <i class="fa fa-paper-plane" aria-hidden="true"/>
                            </button>
                        </div>

                        <!-- Sovereign Security & Compliance Watermark -->
                        <div class="al2c-watermark">
                            <i class="fa fa-shield me-1" aria-hidden="true"/>
                            <span>Innoria Software &amp; AI · TT 13/2020/TT-BTTTT · ISO/IEC 27701 &amp; NĐ 13/2023/NĐ-CP</span>
                        </div>
                    </footer>
                </t>
            </div>
        </div>
    </t>
</templates>
