<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_al2c" model="ir.ui.view">
        <field name="name">account.move.form.al2c</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <field name="al2c_has_open_dispute" invisible="1"/>
                <div class="alert alert-danger mb-0" role="alert" invisible="not al2c_has_open_dispute">
                    <strong>DUNNING FROZEN:</strong> Active commercial dispute on this invoice. Automated dunning collection ladder suspended pursuant to AL2C-INV-103.
                </div>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Decree 70 E-Invoice &amp; Disputes" name="al2c_einvoice_disputes">
                    <group string="Nghị định 70/2025/NĐ-CP E-Invoice Status">
                        <group>
                            <field name="al2c_einvoice_provider"/>
                            <field name="al2c_einvoice_state" widget="badge"/>
                            <field name="al2c_einvoice_number"/>
                        </group>
                        <group>
                            <field name="al2c_einvoice_lookup_code"/>
                            <field name="al2c_einvoice_qr_code" widget="url"/>
                        </group>
                    </group>
                    <group string="Commercial Disputes &amp; Dunning Freeze">
                        <field name="al2c_dispute_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="name"/>
                                <field name="reason"/>
                                <field name="disputed_amount"/>
                                <field name="opened_date"/>
                                <field name="state" widget="badge"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
