<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Commercial Dispute List View -->
    <record id="view_al2c_dispute_tree" model="ir.ui.view">
        <field name="name">al2c.dispute.list</field>
        <field name="model">al2c.dispute</field>
        <field name="arch" type="xml">
            <list string="Commercial Disputes" decoration-danger="state == 'open'" decoration-success="state == 'resolved'">
                <field name="name"/>
                <field name="invoice_id"/>
                <field name="partner_id"/>
                <field name="reason"/>
                <field name="disputed_amount"/>
                <field name="opened_date"/>
                <field name="state" widget="badge" decoration-danger="state == 'open'" decoration-success="state == 'resolved'"/>
            </list>
        </field>
    </record>

    <!-- Commercial Dispute Form View -->
    <record id="view_al2c_dispute_form" model="ir.ui.view">
        <field name="name">al2c.dispute.form</field>
        <field name="model">al2c.dispute</field>
        <field name="arch" type="xml">
            <form string="Commercial Dispute">
                <header>
                    <button name="action_resolve_dispute" string="Mark Resolved (Resume Dunning)" type="object" class="btn-primary" invisible="state != 'open'" groups="account.group_account_manager,sales_team.group_sale_manager"/>
                    <button name="action_cancel_dispute" string="Cancel Dispute" type="object" class="btn-secondary" invisible="state != 'open'" groups="account.group_account_manager,sales_team.group_sale_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,resolved,credit_note_issued,cancelled"/>
                </header>
                <sheet>
                    <div class="alert alert-warning mb-3" role="alert" invisible="state != 'open'">
                        <strong>DUNNING FROZEN:</strong> Active dispute pauses all automated dunning notices and suspension ladders for this customer invoice pursuant to AL2C-INV-103.
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Dispute Reference"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Dispute Details">
                            <field name="invoice_id"/>
                            <field name="partner_id"/>
                            <field name="reason"/>
                            <field name="disputed_amount"/>
                            <field name="company_currency" invisible="1"/>
                        </group>
                        <group string="Timeline &amp; Resolution">
                            <field name="opened_date"/>
                            <field name="resolution_date"/>
                            <field name="resolution_note"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_al2c_dispute" model="ir.actions.act_window">
        <field name="name">Commercial Disputes</field>
        <field name="res_model">al2c.dispute</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No active commercial disputes.
            </p>
        </field>
    </record>

    <!-- Menu Item under Accounting/Invoicing -->
    <menuitem id="menu_al2c_dispute_root"
              name="Commercial Disputes"
              parent="account.menu_finance"
              action="action_al2c_dispute"
              sequence="28"/>
</odoo>
