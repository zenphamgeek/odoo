<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- AL2C TECH ASSET: KANBAN VIEW                                 -->
    <!-- ============================================================ -->
    <record id="view_al2c_tech_asset_kanban" model="ir.ui.view">
        <field name="name">al2c.tech.asset.kanban</field>
        <field name="model">al2c.tech.asset</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_dashboard" default_group_by="category" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <field name="git_branch"/>
                <field name="git_commit"/>
                <field name="is_dirty"/>
                <field name="uncommitted_files_count"/>
                <field name="loc_code"/>
                <field name="loc_test"/>
                <field name="test_coverage_ratio"/>
                <field name="estimated_effort_man_days"/>
                <field name="risk_level"/>
                <field name="risk_score"/>
                <field name="doc_freshness"/>
                <field name="improvement_count"/>
                <field name="p0_improvement_count"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click p-3 rounded shadow-sm border" style="background-color: var(--insilos-bg-card, #ffffff); border-color: var(--insilos-border-subtle, #e2e8f0);">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div>
                                    <span class="badge text-bg-primary fs-7 px-2 py-1"><t t-esc="record.code.value"/></span>
                                    <span t-if="record.is_dirty.raw_value" class="badge text-bg-warning fs-7 ms-1">
                                        ⚠️ <t t-esc="record.uncommitted_files_count.value"/> Dirty
                                    </span>
                                    <span t-else="" class="badge text-bg-success fs-7 ms-1">✅ Clean</span>
                                </div>
                                <div>
                                    <span t-if="record.risk_level.raw_value == 'low'" class="badge text-bg-success">Low Risk (<t t-esc="record.risk_score.value"/>)</span>
                                    <span t-elif="record.risk_level.raw_value == 'medium'" class="badge text-bg-warning">Medium Risk (<t t-esc="record.risk_score.value"/>)</span>
                                    <span t-elif="record.risk_level.raw_value == 'high'" class="badge text-bg-danger">High Risk (<t t-esc="record.risk_score.value"/>)</span>
                                    <span t-elif="record.risk_level.raw_value == 'critical'" class="badge text-bg-dark text-danger border border-danger">Critical (<t t-esc="record.risk_score.value"/>)</span>
                                </div>
                            </div>
                            
                            <h4 class="fw-bold mb-1" style="color: var(--insilos-text-main, #0f172a); font-size: 1.05rem;">
                                <t t-esc="record.name.value"/>
                            </h4>

                            <div class="small text-muted mb-2 font-monospace">
                                🌿 <t t-esc="record.git_branch.value or 'N/A'"/> • <code><t t-esc="record.git_commit.value or 'none'"/></code>
                            </div>

                            <div class="row g-2 text-center my-2 p-2 rounded" style="background: var(--insilos-bg-subtle, #f8fafc); border: 1px solid var(--insilos-border-subtle, #e2e8f0);">
                                <div class="col-4">
                                    <div class="text-muted small">Code LOC</div>
                                    <div class="fw-bold"><t t-esc="record.loc_code.value"/></div>
                                </div>
                                <div class="col-4">
                                    <div class="text-muted small">Test Ratio</div>
                                    <div class="fw-bold"><t t-esc="(record.test_coverage_ratio.raw_value * 100).toFixed(1)"/>%</div>
                                </div>
                                <div class="col-4">
                                    <div class="text-muted small">Effort</div>
                                    <div class="fw-bold text-primary"><t t-esc="record.estimated_effort_man_days.value"/> d</div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                                <div class="small">
                                    <span t-if="record.doc_freshness.raw_value == 'fresh'" class="text-success fw-bold">🟢 Spec Fresh</span>
                                    <span t-elif="record.doc_freshness.raw_value == 'adequate'" class="text-warning fw-bold">🟡 Spec &lt;30d</span>
                                    <span t-elif="record.doc_freshness.raw_value == 'stale'" class="text-danger fw-bold">🔴 Spec Stale</span>
                                    <span t-else="" class="text-muted fw-bold">⚪ Spec Missing</span>
                                </div>
                                <div>
                                    <span t-if="record.p0_improvement_count.raw_value &gt; 0" class="badge text-bg-danger">
                                        <t t-esc="record.p0_improvement_count.value"/> P0
                                    </span>
                                    <span class="badge text-bg-secondary ms-1">
                                        <t t-esc="record.improvement_count.value"/> Items
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- AL2C TECH ASSET: LIST VIEW                                   -->
    <!-- ============================================================ -->
    <record id="view_al2c_tech_asset_list" model="ir.ui.view">
        <field name="name">al2c.tech.asset.list</field>
        <field name="model">al2c.tech.asset</field>
        <field name="arch" type="xml">
            <list string="Technology Assets &amp; Git Repositories" sample="1">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="git_branch"/>
                <field name="git_commit"/>
                <field name="is_dirty" widget="boolean"/>
                <field name="uncommitted_files_count" string="Dirty"/>
                <field name="loc_code" string="Code LOC"/>
                <field name="loc_test" string="Test LOC"/>
                <field name="test_coverage_ratio" widget="percentage"/>
                <field name="estimated_effort_man_days" string="Effort (d)"/>
                <field name="risk_level" widget="badge" decoration-success="risk_level == 'low'" decoration-warning="risk_level == 'medium'" decoration-danger="risk_level in ('high', 'critical')"/>
                <field name="risk_score" string="Risk"/>
                <field name="doc_freshness" widget="badge" decoration-success="doc_freshness == 'fresh'" decoration-warning="doc_freshness == 'adequate'" decoration-danger="doc_freshness in ('stale', 'missing')"/>
                <field name="last_sync_date"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- AL2C TECH ASSET: FORM VIEW                                   -->
    <!-- ============================================================ -->
    <record id="view_al2c_tech_asset_form" model="ir.ui.view">
        <field name="name">al2c.tech.asset.form</field>
        <field name="model">al2c.tech.asset</field>
        <field name="arch" type="xml">
            <form string="Technology Asset &amp; Git Repository">
                <header>
                    <button name="action_full_telemetry_cycle" string="⚡ Full Telemetry Cycle" type="object" class="btn-primary"/>
                    <button name="action_scan_and_sync_git" string="🔍 Scan &amp; Sync Git" type="object" class="btn-secondary"/>
                    <button name="action_evaluate_estimation_and_risk" string="📊 Re-evaluate Risk &amp; Effort" type="object" class="btn-secondary"/>
                    <button name="action_generate_improvement_backlog" string="🚀 Synthesize Backlog" type="object" class="btn-secondary"/>
                    <button name="action_sync_documents_and_knowledge" string="📘 Sync Knowledge &amp; Docs" type="object" class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="active,development,maintenance,archived"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_generate_improvement_backlog" icon="fa-tasks">
                            <field string="Improvements" name="improvement_count" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Technology Asset Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Insilos O20 Core ERP Platform"/>
                        </h1>
                        <h3>
                            <span class="badge text-bg-primary me-2"><field name="code"/></span>
                            <span class="text-muted"><field name="category"/></span>
                        </h3>
                    </div>
                    <group>
                        <group string="Repository Configuration">
                            <field name="repo_path"/>
                            <field name="tech_stack"/>
                            <field name="complexity_rating"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Documentation &amp; Living Spec">
                            <field name="primary_doc_path"/>
                            <field name="doc_freshness" widget="badge"/>
                            <field name="doc_last_modified"/>
                            <field name="last_sync_date"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Git Telemetry &amp; Estimation" name="git_estimation">
                            <group>
                                <group string="Git Working Tree Status">
                                    <field name="git_branch"/>
                                    <field name="git_commit"/>
                                    <field name="git_commit_message"/>
                                    <field name="git_commit_author"/>
                                    <field name="git_commit_date"/>
                                    <field name="is_dirty"/>
                                    <field name="uncommitted_files_count"/>
                                    <field name="recent_commits_30d"/>
                                </group>
                                <group string="Code Sizing &amp; Man-Days Effort">
                                    <field name="total_files_count"/>
                                    <field name="loc_code"/>
                                    <field name="loc_test"/>
                                    <field name="loc_docs"/>
                                    <field name="test_coverage_ratio" widget="percentage"/>
                                    <field name="estimated_effort_man_days"/>
                                    <field name="estimated_delivery_weeks"/>
                                    <field name="tech_debt_score"/>
                                </group>
                            </group>
                        </page>

                        <page string="Risk &amp; Health Analysis" name="risk_health">
                            <group>
                                <group string="Risk Classification">
                                    <field name="risk_level" widget="badge" decoration-success="risk_level == 'low'" decoration-warning="risk_level == 'medium'" decoration-danger="risk_level in ('high', 'critical')"/>
                                    <field name="risk_score"/>
                                    <field name="architectural_drift" widget="badge"/>
                                </group>
                            </group>
                            <separator string="Identified Risk Factors"/>
                            <field name="risk_factors" readonly="1" class="font-monospace"/>
                        </page>

                        <page string="Living Documentation &amp; Knowledge Card" name="living_docs">
                            <group>
                                <field name="knowledge_article_id" readonly="1"/>
                                <field name="document_folder_id" readonly="1"/>
                            </group>
                            <separator string="Rendered Living Architectural Profile"/>
                            <field name="living_doc_summary" widget="html" readonly="1"/>
                        </page>

                        <page string="Improvement Backlog (Backlog v2)" name="improvements">
                            <field name="improvement_ids">
                                <list editable="bottom" decoration-danger="priority == 'P0'" decoration-warning="priority == 'P1'">
                                    <field name="item_code"/>
                                    <field name="priority" widget="badge"/>
                                    <field name="name"/>
                                    <field name="category"/>
                                    <field name="risk_level" widget="badge"/>
                                    <field name="state" widget="badge"/>
                                    <field name="estimated_hours"/>
                                    <field name="definition_of_done"/>
                                    <field name="backlog_v2_line" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- AL2C TECH ASSET IMPROVEMENT: LIST & FORM                     -->
    <!-- ============================================================ -->
    <record id="view_al2c_tech_asset_improvement_list" model="ir.ui.view">
        <field name="name">al2c.tech.asset.improvement.list</field>
        <field name="model">al2c.tech.asset.improvement</field>
        <field name="arch" type="xml">
            <list string="Autonomous Tech Improvements &amp; Backlog v2" sample="1">
                <field name="item_code"/>
                <field name="priority" widget="badge" decoration-danger="priority == 'P0'" decoration-warning="priority == 'P1'" decoration-info="priority == 'P2'"/>
                <field name="name"/>
                <field name="asset_id"/>
                <field name="category"/>
                <field name="risk_level" widget="badge"/>
                <field name="state" widget="badge" decoration-success="state == 'verified'" decoration-info="state == 'in_progress'" decoration-warning="state == 'queued'"/>
                <field name="estimated_hours"/>
                <field name="definition_of_done"/>
            </list>
        </field>
    </record>

    <record id="view_al2c_tech_asset_improvement_form" model="ir.ui.view">
        <field name="name">al2c.tech.asset.improvement.form</field>
        <field name="model">al2c.tech.asset.improvement</field>
        <field name="arch" type="xml">
            <form string="Tech Asset Improvement Item">
                <header>
                    <button name="action_queue_for_swarm" string="🚀 Queue for Swarm" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_mark_verified" string="✅ Mark Verified / Done" type="object" class="btn-success" invisible="state not in ('in_progress', 'queued')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,queued,in_progress,verified"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Improvement Title"/>
                        <h1>
                            <field name="name" placeholder="e.g. Expand regression test coverage"/>
                        </h1>
                        <h3>
                            <span class="badge text-bg-primary me-2"><field name="item_code"/></span>
                            <span class="badge text-bg-secondary"><field name="priority"/></span>
                        </h3>
                    </div>
                    <group>
                        <group string="Classification">
                            <field name="asset_id"/>
                            <field name="category"/>
                            <field name="risk_level"/>
                            <field name="estimated_hours"/>
                        </group>
                        <group string="Verification Target">
                            <field name="target_file_path"/>
                            <field name="verification_command"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Context &amp; Definition of Done" name="dod">
                            <group>
                                <field name="definition_of_done"/>
                                <field name="description"/>
                            </group>
                            <separator string="Backlog v2 Markdown Specification Line"/>
                            <field name="backlog_v2_line" readonly="1" class="font-monospace"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- WINDOW ACTIONS & MENUS                                       -->
    <!-- ============================================================ -->
    <record id="action_al2c_tech_asset" model="ir.actions.act_window">
        <field name="name">Technology Assets &amp; Git Repositories</field>
        <field name="res_model">al2c.tech.asset</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register your first Technology Asset or Git Repository!
            </p>
            <p>
                Track live git telemetry, code LOC sizing, man-days effort estimation, and composite risk scores.
            </p>
        </field>
    </record>

    <record id="action_al2c_tech_asset_improvement" model="ir.actions.act_window">
        <field name="name">Tech Improvement Backlog (v2)</field>
        <field name="res_model">al2c.tech.asset.improvement</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No improvement items queued. Run a full telemetry cycle on tech assets to synthesize new items!
            </p>
        </field>
    </record>

    <!-- Menus under Project / PMO -->
    <menuitem id="menu_al2c_tech_asset_root"
              name="Tech Assets"
              parent="project.menu_main_pm"
              sequence="30"/>

    <menuitem id="menu_al2c_tech_asset_registry"
              name="Git Repository Registry"
              parent="menu_al2c_tech_asset_root"
              action="action_al2c_tech_asset"
              sequence="10"/>

    <menuitem id="menu_al2c_tech_asset_improvements"
              name="Improvement Backlog v2"
              parent="menu_al2c_tech_asset_root"
              action="action_al2c_tech_asset_improvement"
              sequence="20"/>

    <!-- Cross-links in Documents & Sales for convenience -->
    <menuitem id="menu_al2c_tech_asset_docs"
              name="Tech Asset Registry"
              parent="documents.menu_root"
              action="action_al2c_tech_asset"
              sequence="50"/>

    <menuitem id="menu_al2c_tech_asset_sales"
              name="Tech Assets &amp; Repos"
              parent="sale.sale_menu_root"
              action="action_al2c_tech_asset"
              sequence="45"/>
</odoo>
