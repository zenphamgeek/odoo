<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- =====================================================================
         INNORIA / INSILOS ENTERPRISE REPORT TEMPLATES
         Architecture: IBM Carbon Design Language and SAP Fiori Horizon Standards
         Branding: Official Web Innoria Logo (Small Header and Discrete Footer)
         Statutory: Decree 123/2020/ND-CP and Decree 70/2025/ND-CP (e-Invoicing)
         ===================================================================== -->

    <!-- 1. Master IBM Carbon and SAP Fiori External Report Layout -->
    <template id="external_layout_ibm_sap" name="Innoria Enterprise (IBM Carbon &amp;amp; SAP Fiori)">
        <t t-if="not o" t-set="o" t-value="doc"/>
        <t t-if="not company">
            <t t-if="company_id">
                <t t-set="company" t-value="company_id"/>
            </t>
            <t t-elif="o and 'company_id' in o and o.company_id.sudo()">
                <t t-set="company" t-value="o.company_id.sudo()"/>
            </t>
            <t t-else="">
                <t t-set="company" t-value="res_company"/>
            </t>
        </t>

        <!-- HEADER -->
        <div t-attf-class="o_company_#{company.id}_layout header" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 11px; color: #161616;">
            <!-- SAP Fiori Horizon Sapphire Accent Stripe -->
            <div style="height: 3px; background: linear-gradient(90deg, #0070F2 0%, #0ABBDB 100%); margin-bottom: 12px;"/>
            
            <table class="table-borderless w-100" style="margin-bottom: 8px;">
                <tr>
                    <!-- Small Web Innoria Logo and Enterprise Badge -->
                    <td class="align-middle text-start" style="width: 50%;">
                        <img src="/insilos_al2c/static/src/img/logo_innoria_header.png" style="max-height: 32px; width: auto; display: block;" alt="Innoria"/>
                        <div style="margin-top: 4px;">
                            <span style="font-family: ui-monospace, Menlo, Monaco, Consolas, monospace; font-size: 9px; letter-spacing: 0.05em; color: #525252; background: #F4F4F4; border: 1px solid #E0E0E0; padding: 2px 6px; border-radius: 2px;">
                                ISO/IEC 27001 · SOVEREIGN ENTERPRISE
                            </span>
                        </div>
                    </td>
                    <!-- Discrete IBM Masthead Information -->
                    <td class="align-middle text-end" style="width: 50%; font-size: 10px; line-height: 1.4; color: #525252;">
                        <strong style="font-size: 11px; color: #161616;" t-out="company.name"/><br/>
                        <span t-if="company.vat">Mã số thuế / Tax ID: <strong style="color: #161616;" t-out="company.vat"/> | </span>
                        <span t-if="company.phone" t-out="company.phone"/><br/>
                        <span t-if="company.street" t-out="company.street"/>, <span t-if="company.city" t-out="company.city"/><br/>
                        <span style="color: #0070F2; font-weight: 600;">https://innoria.com</span>
                    </td>
                </tr>
            </table>
            <div style="height: 1px; background-color: #E0E0E0; width: 100%; margin-bottom: 16px;"/>
        </div>

        <!-- BODY -->
        <t t-call="web.external_layout_body" snail_mail_compatible="True">
            <div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; color: #161616;">
                <t t-out="0"/>
            </div>
        </t>

        <!-- FOOTER -->
        <div t-attf-class="footer o_company_#{company.id}_layout {{report_type != 'pdf' and 'mt-auto'}}" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 9px; color: #6F6F6F; border-top: 1px solid #E0E0E0; padding-top: 6px;">
            <table class="table-borderless w-100">
                <tr>
                    <td class="text-start align-middle" style="width: 75%;">
                        <div>
                            <strong>INNORIA ENTERPRISE PLATFORM</strong> · Chứng từ điện tử khởi tạo tự động theo Nghị định 123/2020/NĐ-CP &amp;amp; Nghị định 70/2025/NĐ-CP.
                        </div>
                        <div style="color: #8D8D8D; margin-top: 2px;">
                            Bảo mật dữ liệu tuân thủ Nghị định 13/2023/NĐ-CP. Tra cứu tính hợp lệ tại cổng khách hàng: <span style="color: #0070F2;">https://innoria.com</span>
                        </div>
                    </td>
                    <td class="text-end align-middle" style="width: 25%;">
                        <div t-if="report_type == 'pdf'" class="text-nowrap" style="font-weight: 600; color: #161616;">
                            Trang <span class="page"/> / <span class="topage"/>
                        </div>
                        <div t-else="" class="text-nowrap" style="font-weight: 600; color: #161616;">
                            Trang 1 / 1
                        </div>
                    </td>
                </tr>
            </table>
        </div>
    </template>

    <!-- 2. Global Extension on web.external_layout_standard ensuring all default reports adopt IBM/SAP and Innoria Small Logo -->
    <template id="external_layout_standard_inherit_al2c" inherit_id="web.external_layout_standard">
        <!-- Replace Header (First div) -->
        <xpath expr="//div[1]" position="replace">
            <div t-attf-class="o_company_#{company.id}_layout header" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 11px; color: #161616;">
                <!-- SAP Horizon Blue accent stripe -->
                <div style="height: 3px; background: linear-gradient(90deg, #0070F2 0%, #0ABBDB 100%); margin-bottom: 12px;"/>
                <table class="table-borderless w-100" style="margin-bottom: 8px;">
                    <tr>
                        <td class="align-middle text-start" style="width: 50%;">
                            <img src="/insilos_al2c/static/src/img/logo_innoria_header.png" style="max-height: 32px; width: auto; display: block;" alt="Innoria"/>
                            <div style="margin-top: 4px;">
                                <span style="font-family: ui-monospace, Menlo, Monaco, Consolas, monospace; font-size: 9px; letter-spacing: 0.05em; color: #525252; background: #F4F4F4; border: 1px solid #E0E0E0; padding: 2px 6px; border-radius: 2px;">
                                    ISO/IEC 27001 · SOVEREIGN ENTERPRISE
                                </span>
                            </div>
                        </td>
                        <td class="align-middle text-end" style="width: 50%; font-size: 10px; line-height: 1.4; color: #525252;">
                            <strong style="font-size: 11px; color: #161616;" t-out="company.name"/><br/>
                            <span t-if="company.vat">Mã số thuế: <strong style="color: #161616;" t-out="company.vat"/> | </span>
                            <span t-if="company.phone" t-out="company.phone"/><br/>
                            <span t-if="company.street" t-out="company.street"/>, <span t-if="company.city" t-out="company.city"/><br/>
                            <span style="color: #0070F2; font-weight: 600;">https://innoria.com</span>
                        </td>
                    </tr>
                </table>
                <div style="height: 1px; background-color: #E0E0E0; width: 100%; margin-bottom: 16px;"/>
            </div>
        </xpath>

        <!-- Replace Footer (Last div) -->
        <xpath expr="//div[last()]" position="replace">
            <div t-attf-class="footer o_company_#{company.id}_layout {{report_type != 'pdf' and 'mt-auto'}}" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 9px; color: #6F6F6F; border-top: 1px solid #E0E0E0; padding-top: 6px;">
                <table class="table-borderless w-100">
                    <tr>
                        <td class="text-start align-middle" style="width: 75%;">
                            <div>
                                <strong>INNORIA ENTERPRISE PLATFORM</strong> · Chứng từ điện tử chuẩn ISO/IEC 27001 &amp;amp; Nghị định 123/2020/NĐ-CP.
                            </div>
                            <div style="color: #8D8D8D; margin-top: 2px;">
                                Bảo mật dữ liệu cá nhân theo Nghị định 13/2023/NĐ-CP. Tra cứu trực tuyến tại: <span style="color: #0070F2;">https://innoria.com</span>
                            </div>
                        </td>
                        <td class="text-end align-middle" style="width: 25%;">
                            <div t-if="report_type == 'pdf'" class="text-nowrap" style="font-weight: 600; color: #161616;">
                                Trang <span class="page"/> / <span class="topage"/>
                            </div>
                            <div t-else="" class="text-nowrap" style="font-weight: 600; color: #161616;">
                                Trang 1 / 1
                            </div>
                        </td>
                    </tr>
                </table>
            </div>
        </xpath>
    </template>
</odoo>
