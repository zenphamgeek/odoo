<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_al2c" model="ir.ui.view">
        <field name="name">sale.order.form.al2c</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='order_details']/field[@name='validity_date']" position="before">
                <field name="al2c_approval_required" invisible="1"/>
                <field name="al2c_approved"
                       invisible="not al2c_approval_required and not al2c_approved"
                       groups="sales_team.group_sale_manager"/>
                <field name="value_case_id"/>
            </xpath>
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-0" role="alert"
                     invisible="not al2c_approval_required or al2c_approved">
                    This agent-prepared quotation exceeds the deal-desk thresholds and needs sales-manager approval before it can be sent or confirmed.
                </div>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Fit-to-Standard Clean Core Scope" name="al2c_fts">
                    <field name="fts_item_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="clean_core_class"/>
                            <field name="module"/>
                            <field name="name"/>
                            <field name="approved_by_architect"/>
                            <field name="architect_user_id"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
