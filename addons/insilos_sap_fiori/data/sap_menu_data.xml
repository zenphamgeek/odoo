    <!-- SAP Movement Types Matrix Data Records (BWART)                      -->
    <!-- =================================================================== -->
    <record id="sap_bwart_101" model="sap.movement.type">
        <field name="code">101</field>
        <field name="name">Goods Receipt for Purchase Order into Unrestricted Stock</field>
        <field name="process_category">GR</field>
        <field name="source_location_desc">Vendor / Supplier BP</field>
        <field name="dest_location_desc">Storage Location (SLoc / Internal)</field>
        <field name="sap_tcode">MIGO / VL31N</field>
        <field name="description">Standard goods receipt posting for purchase orders into unrestricted-use inventory. Increases book inventory.</field>
    </record>

    <record id="sap_bwart_102" model="sap.movement.type">
        <field name="code">102</field>
        <field name="name">Return Delivery to Vendor / Goods Receipt Reversal</field>
        <field name="process_category">GR</field>
        <field name="source_location_desc">Storage Location (SLoc / Internal)</field>
        <field name="dest_location_desc">Vendor / Supplier BP</field>
        <field name="sap_tcode">MIGO</field>
        <field name="description">Reversal of goods receipt for purchase order or return delivery to vendor.</field>
    </record>

    <record id="sap_bwart_261" model="sap.movement.type">
        <field name="code">261</field>
        <field name="name">Goods Issue for Production Order Reservation</field>
        <field name="process_category">GI</field>
        <field name="source_location_desc">Storage Location (SLoc / Internal)</field>
        <field name="dest_location_desc">Production Order (RESB / CO01)</field>
        <field name="sap_tcode">MIGO / MB1A</field>
        <field name="description">Consumption of raw materials or components for manufacturing production orders.</field>
    </record>

    <record id="sap_bwart_301" model="sap.movement.type">
        <field name="code">301</field>
        <field name="name">Transfer Posting Plant to Plant (One-Step)</field>
        <field name="process_category">TP</field>
        <field name="source_location_desc">Issuing Plant (Werks A)</field>
        <field name="dest_location_desc">Receiving Plant (Werks B)</field>
        <field name="sap_tcode">MIGO / MB1B</field>
        <field name="description">One-step stock transfer posting between two distinct plants within the company.</field>
    </record>

    <record id="sap_bwart_311" model="sap.movement.type">
        <field name="code">311</field>
        <field name="name">Transfer Posting Storage Location to Storage Location</field>
        <field name="process_category">TP</field>
        <field name="source_location_desc">Source Storage Location (SLoc 1)</field>
        <field name="dest_location_desc">Destination Storage Location (SLoc 2)</field>
        <field name="sap_tcode">MIGO / MB1B</field>
        <field name="description">Transfer posting of materials between two storage locations within the same plant.</field>
    </record>

    <record id="sap_bwart_601" model="sap.movement.type">
        <field name="code">601</field>
        <field name="name">Goods Issue for Outbound Delivery (Post Goods Issue)</field>
        <field name="process_category">GI</field>
        <field name="source_location_desc">Storage Location (SLoc / Internal)</field>
        <field name="dest_location_desc">Customer / Sold-to Party</field>
        <field name="sap_tcode">VL01N / VL02N</field>
        <field name="description">Post Goods Issue (PGI) reducing inventory balance and transferring ownership to customer on outbound delivery.</field>
    </record>

    <record id="sap_bwart_701" model="sap.movement.type">
        <field name="code">701</field>
        <field name="name">Physical Inventory Difference: Book Surplus Posting (Gain)</field>
        <field name="process_category">PI</field>
        <field name="source_location_desc">Inventory Difference (Inventory Loss)</field>
        <field name="dest_location_desc">Storage Location (SLoc / Internal)</field>
        <field name="sap_tcode">MI07</field>
        <field name="description">Physical inventory adjustment posting for surplus counted quantity exceeding book stock.</field>
    </record>

    <record id="sap_bwart_702" model="sap.movement.type">
        <field name="code">702</field>
        <field name="name">Physical Inventory Difference: Book Deficit Posting (Loss)</field>
        <field name="process_category">PI</field>
        <field name="source_location_desc">Storage Location (SLoc / Internal)</field>
        <field name="dest_location_desc">Inventory Difference (Inventory Loss)</field>
        <field name="sap_tcode">MI07</field>
        <field name="description">Physical inventory adjustment posting for deficit counted quantity below book stock.</field>
    </record>

