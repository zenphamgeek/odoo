<?xml version="1.0" encoding="utf-8"?>
<data>
        <!-- =================================================================== -->
        <!-- 1. Sales & Distribution (SD) Views                                  -->
        <!-- =================================================================== -->
        <record id="view_order_form_sap_sd" model="ir.ui.view">
            <field name="name">sale.order.form.sap.sd</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="priority">20</field>
            <field name="arch" type="xml">
                <xpath expr="//div[@class='oe_title']" position="inside">
                    <div class="mt-1 mb-2">
                        <field name="sap_document_type" widget="badge"
                               decoration-info="state in ('draft', 'sent')"
                               decoration-success="state == 'sale'"
                               decoration-warning="state == 'cancel'"/>
                    </div>
                </xpath>
            </field>
        </record>

        <record id="view_quotation_tree_sap_sd" model="ir.ui.view">
            <field name="name">sale.quotation.tree.sap.sd</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding"/>
            <field name="priority">20</field>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="sap_document_type" widget="badge" optional="show"
                           decoration-info="state in ('draft', 'sent')"
                           decoration-success="state == 'sale'"/>
                </xpath>
            </field>
        </record>

        <record id="view_order_tree_sap_sd" model="ir.ui.view">
            <field name="name">sale.order.tree.sap.sd</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_tree"/>
            <field name="priority">20</field>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="sap_document_type" widget="badge" optional="show"
                           decoration-info="state in ('draft', 'sent')"
                           decoration-success="state == 'sale'"/>
                </xpath>
            </field>
        </record>

        <!-- =================================================================== -->
        <!-- Customer Billing Documents (account.move) Views                     -->
        <!-- =================================================================== -->
        <record id="view_move_form_sap_billing" model="ir.ui.view">
            <field name="name">account.move.form.sap.billing</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="priority">20</field>
            <field name="arch" type="xml">
                <xpath expr="//div[@class='oe_title']" position="inside">
                    <div class="mt-1 mb-2" invisible="move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund')">
                        <field name="sap_billing_type" widget="badge"
                               decoration-success="move_type == 'out_invoice'"
                               decoration-info="move_type == 'out_refund'"
                               decoration-warning="move_type in ('in_invoice', 'in_refund')"/>
                    </div>
                </xpath>
            </field>
        </record>

        <record id="view_invoice_tree_sap_billing" model="ir.ui.view">
            <field name="name">account.invoice.tree.sap.billing</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_invoice_tree"/>
            <field name="priority">20</field>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="sap_billing_type" widget="badge" optional="show"
                           decoration-success="move_type == 'out_invoice'"
                           decoration-info="move_type == 'out_refund'"
                           decoration-warning="move_type in ('in_invoice', 'in_refund')"/>
                </xpath>
            </field>
        </record>

        <!-- =================================================================== -->
        <!-- 2. Materials Management (MM) Views                                  -->
        <!-- =================================================================== -->
        <record id="purchase_order_form_sap_mm" model="ir.ui.view">
            <field name="name">purchase.order.form.sap.mm</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="priority">20</field>
            <field name="arch" type="xml">
                <xpath expr="//div[@class='oe_title']" position="inside">
                    <div class="mt-1 mb-2">
                        <field name="sap_document_type" widget="badge"
                               decoration-info="state in ('draft', 'sent')"
                               decoration-success="state in ('purchase', 'done')"
                               decoration-warning="state == 'cancel'"/>
                    </div>
                </xpath>
            </field>
        </record>

        <record id="purchase_order_tree_sap_mm" model="ir.ui.view">
            <field name="name">purchase.order.tree.sap.mm</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
            <field name="priority">20</field>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="sap_document_type" widget="badge" optional="show"
                           decoration-info="state in ('draft', 'sent')"
                           decoration-success="state in ('purchase', 'done')"/>
                </xpath>
            </field>
        </record>

        <record id="purchase_order_kpis_tree_sap_mm" model="ir.ui.view">
            <field name="name">purchase.order.kpis.tree.sap.mm</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
            <field name="priority">20</field>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="sap_document_type" widget="badge" optional="show"
                           decoration-info="state in ('draft', 'sent')"
                           decoration-success="state in ('purchase', 'done')"/>
                </xpath>
            </field>
        </record>

        <!-- Purchase Requisition Views -->
        <record id="view_purchase_requisition_tree_sap_mm" model="ir.ui.view">
            <field name="name">purchase.requisition.tree.sap.mm</field>
            <field name="model">purchase.requisition</field>
            <field name="inherit_id" ref="purchase_requisition.view_purchase_requisition_tree"/>
            <field name="priority">20</field>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='requisition_type']" position="attributes">
                    <attribute name="widget">badge</attribute>
                    <attribute name="decoration-primary">requisition_type == 'blanket_order'</attribute>
                </xpath>
            </field>
        </record>

        <!-- =================================================================== -->
        <!-- Goods Deliveries & Movements (stock.picking) Views                  -->
        <!-- =================================================================== -->
        <record id="view_picking_form_sap_movement" model="ir.ui.view">
            <field name="name">stock.picking.form.sap.movement</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="priority">20</field>
            <field name="arch" type="xml">
                <xpath expr="//div[@class='oe_title']" position="inside">
                    <div class="d-flex gap-2 my-1">
                        <field name="sap_movement_type" widget="badge"
                               decoration-info="sap_movement_type == '101'"
                               decoration-warning="sap_movement_type == '601'"
                               decoration-primary="sap_movement_type == '311'"/>
                        <field name="sap_delivery_type" widget="badge"
                               decoration-success="picking_type_code == 'outgoing'"
                               decoration-info="picking_type_code == 'incoming'"/>
                    </div>
                </xpath>
            </field>
        </record>

        <record id="vpicktree_sap_movement" model="ir.ui.view">
            <field name="name">stock.picking.tree.sap.movement</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.vpicktree"/>
            <field name="priority">20</field>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="sap_movement_type" widget="badge" optional="show"
                           decoration-info="sap_movement_type == '101'"
                           decoration-warning="sap_movement_type == '601'"
                           decoration-primary="sap_movement_type == '311'"/>
                    <field name="sap_delivery_type" optional="show"/>
                </xpath>
            </field>
        </record>

        <!-- =================================================================== -->
        <!-- Physical Inventory Adjustments (stock.quant) Views                  -->
        <!-- =================================================================== -->
        <record id="view_stock_quant_tree_inventory_editable_sap" model="ir.ui.view">
            <field name="name">stock.quant.inventory.list.editable.sap</field>
            <field name="model">stock.quant</field>
            <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
            <field name="priority">20</field>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='inventory_diff_quantity']" position="after">
                    <field name="sap_movement_type" widget="badge" optional="show"
                           decoration-success="sap_movement_type == '701'"
                           decoration-danger="sap_movement_type == '702'"/>
                </xpath>
            </field>
        </record>

        <!-- =================================================================== -->
        <!-- SAP Movement Types Matrix (sap.movement.type) Views & Action        -->
        <!-- =================================================================== -->
        <record id="view_sap_movement_type_tree" model="ir.ui.view">
            <field name="name">sap.movement.type.tree</field>
            <field name="model">sap.movement.type</field>
            <field name="arch" type="xml">
                <list string="SAP Stock Movement Types Matrix (BWART)">
                    <field name="code" decoration-bf="1"/>
                    <field name="name"/>
                    <field name="process_category" widget="badge"
                           decoration-info="process_category == 'GR'"
                           decoration-warning="process_category == 'GI'"
                           decoration-primary="process_category == 'TP'"
                           decoration-success="process_category == 'PI'"/>
                    <field name="source_location_desc"/>
                    <field name="dest_location_desc"/>
                    <field name="sap_tcode"/>
                </list>
            </field>
        </record>

        <record id="view_sap_movement_type_form" model="ir.ui.view">
            <field name="name">sap.movement.type.form</field>
            <field name="model">sap.movement.type</field>
            <field name="arch" type="xml">
                <form string="SAP Stock Movement Type (BWART)">
                    <sheet>
                        <div class="oe_title">
                            <label for="code" string="Movement Type (BWART)"/>
                            <h1><field name="code" placeholder="e.g. 101, 601"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="process_category"/>
                                <field name="sap_tcode"/>
                            </group>
                            <group>
                                <field name="source_location_desc"/>
                                <field name="dest_location_desc"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Business Description">
                                <field name="description"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_sap_movement_type" model="ir.actions.act_window">
            <field name="name">SAP Movement Types Matrix (BWART)</field>
            <field name="res_model">sap.movement.type</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    SAP Standard Stock Movement Types Reference Matrix
                </p>
                <p>
                    Standard SAP BWART inventory movements including 101 (Goods Receipt for PO), 601 (Goods Issue for Outbound Delivery), 701/702 (Physical Inventory Difference).
                </p>
            </field>
        </record>

        <menuitem id="menu_sap_movement_type_list"
                  name="SAP Movement Types Matrix (BWART)"
                  parent="stock.menu_warehouse_config"
                  action="action_sap_movement_type"
                  sequence="50"/>
    </data>
