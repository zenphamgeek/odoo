<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="mail.Thread">
    <div class="o-mail-Thread position-relative flex-grow-1 d-flex flex-column overflow-auto o-scrollbar-thin bg-inherit" t-att-class="{ 'pb-5': this.env.inChatter?.aside, 'o-pb-3_5': !this.env.inChatter?.aside, 'ps-2 pe-3': this.env.inDiscussApp and !this.ui.isSmall, 'o-focused': this.props.thread.isFocused }" t-att-data-transient="this.props.thread.isTransient" t-ref="this.rootRef" tabindex="-1" t-on-focusin="this.onFocusin" t-on-focusout="this.onFocusout">
        <t t-if="!this.props.thread.isEmpty or this.props.thread.loadOlder or this.props.thread.hasLoadingFailed" name="content">
            <div class="o-mail-Thread-content d-flex flex-column position-relative flex-grow-1 bg-inherit" t-att-class="{'justify-content-end': !this.env.inChatter}">
                <span class="position-absolute w-100 invisible" t-att-class="this.props.order === 'asc' ? 'bottom-0' : 'top-0'" t-ref="this.presentThresholdRef" t-att-style="`height: Min(${this.PRESENT_THRESHOLD}px, 100%)`"/>
                <t t-set="currentDay" t-value="0"/>
                <t t-if="this.props.order === 'asc'">
                    <t t-if="this.showLoadOlder" t-call="mail.Thread.loadOlder"/>
                    <t t-elif="this.isInErrorState" t-call="mail.Thread.loadingError"/>
                    <t t-elif="this.showStartMessage" t-call="mail.Thread.startMessage"/>
                </t>
                <span t-else="" class="pt-1" t-ref="this.present"/>
                <t t-set="messages" t-value="this.orderedMessages"/>
                <t t-foreach="messages" t-as="msg" t-key="msg.id">
                    <t t-set="prevMsg" t-value="messages[msg_index -1]"/>
                    <t t-if="msg.dateDay !== currentDay and this.props.showDates">
                        <DateSection date="msg.dateDay" className="'pt-2 px-2'"/>
                        <t t-set="currentDay" t-value="msg.dateDay"/>
                    </t>
                    <div t-if="this.showNewMessageLine(msg, prevMsg)" class="o-mail-Thread-newMessage d-flex align-items-center fw-bold z-1 px-2">
                        <div class="o-mail-Thread-newMessageLine flex-grow-1 border border-danger rounded-start-3 opacity-100 my-1"/><span class="o-ps-1_5 pe-1 bg-danger o-text-white rounded text-uppercase o-xxsmaller">New</span>
                    </div>
                    <NotificationMessage t-if="msg.isNotification and !msg.notificationHidden" message="msg" messageRefs="this.messageRefs" thread="this.props.thread"/>
                    <Message
                        t-elif="!msg.isNotification"
                        className="this.getMessageClassName(msg)"
                        message="msg"
                        messageSelection="this.messageSelection"
                        messageRefs="this.messageRefs"
                        previousMessage="prevMsg"
                        squashed="this.isSquashed(msg, prevMsg)"
                        onParentMessageClick="this.onParentMessageClick"
                        thread="this.props.thread"
                        isFirstMessage="msg_first"
                        hasActions="!msg.eq(this.channel?.from_message_id)"
                        showDates="this.props.showDates"
                    />
                </t>
                <span t-if="this.props.order === 'asc'" class="pt-1" t-ref="this.present"/>
                <t t-else="">
                    <t t-if="this.showLoadOlder" t-call="mail.Thread.loadOlder" name="loadOlder"/>
                    <t t-if="this.props.thread.isInErrorState" t-call="mail.Thread.loadingError"/>
                </t>
            </div>
        </t>
        <t t-else="">
            <div class="o-mail-Thread-empty d-flex flex-column h-100"
                t-att-class="{
                    'p-4': this.props.showEmptyMessage and !this.showStartMessage,
                    'align-items-start justify-content-end': this.showStartMessage,
                    'align-items-center justify-content-center opacity-75': !this.showStartMessage
                }">
                <t t-if="this.state.mountedAndLoaded and this.props.showEmptyMessage">
                    <t name="empty-message">
                        <t t-if="this.showStartMessage" t-call="mail.Thread.startMessage"/>
                        <div t-else="" class="d-flex flex-column align-items-center o_insilos_empty_thread py-4">
                            <div class="o_insilos_empty_icon mb-3 position-relative d-flex align-items-center justify-content-center">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="56" height="56" fill="none" class="insilos-duotone-chats">
                                    <circle cx="32" cy="32" r="28" fill="url(#insilos_thread_empty_glow)" opacity="0.6"/>
                                    <path d="M14 20C14 15.5817 17.5817 12 22 12H42C46.4183 12 50 15.5817 50 20V34C50 38.4183 46.4183 42 42 42H28L18 50V42H22C17.5817 42 14 38.4183 14 34V20Z" fill="#0B2E64" fill-opacity="0.12" stroke="#0B2E64" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="o_insilos_bubble_primary"/>
                                    <path d="M22 22H38M22 28H32M22 34H28" stroke="#0B2E64" stroke-width="2" stroke-linecap="round" opacity="0.6" class="o_insilos_bubble_lines"/>
                                    <path d="M38 32H46C49.3137 32 52 34.6863 52 38V46C52 49.3137 49.3137 52 46 52H44V56L39 52H38C34.6863 52 32 49.3137 32 46V44" fill="#00F0FF" fill-opacity="0.2" stroke="#00F0FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="o_insilos_bubble_accent"/>
                                    <defs>
                                        <radialGradient id="insilos_thread_empty_glow" cx="50%" cy="50%" r="50%">
                                            <stop offset="0%" stop-color="#00F0FF" stop-opacity="0.25"/>
                                            <stop offset="100%" stop-color="#00F0FF" stop-opacity="0"/>
                                        </radialGradient>
                                    </defs>
                                </svg>
                            </div>
                            <span class="fw-semibold text-muted fs-6 mb-1">No messages yet.</span>
                            <span class="small text-muted opacity-75">Start the conversation or drop notes here</span>
                        </div>
                    </t>
                </t>
            </div>
        </t>
        <t t-call="mail.Thread.jumpPresent"/>
    </div>
</t>

<t t-name="mail.Thread.jumpPresent">
    <button t-if="this.props.showJumpPresent and this.state.showJumpPresent" class="o-mail-Thread-jumpPresent position-fixed p-2 rounded-circle lh-1 m-n3 user-select-none btn btn-light border border-dark" t-att-class="{ 'bottom-0': this.env.inChatter and !this.env.inChatter.aside }" t-ref="this.jumpPresentRef" t-on-click="() => this.jumpToPresent()" title="Jump to Present"><i class="oi" t-att-data-icon="this.props.order === 'asc' ? 'keyboard_arrow_down' : 'keyboard_arrow_up'"/></button>
</t>

<t t-name="mail.Thread.loadOlder">
    <button t-att-class="this.loadMoreClass" t-on-click="this.onClickLoadOlder" t-ref="this.loadOlderRef">Load More</button>
</t>

<t t-name="mail.Thread.loadingError">
    <div class="d-flex flex-grow-1 align-items-center justify-content-center flex-column">
        <span class="fs-1">😔</span>
        <div class="o-mail-Thread-error">
            <t t-out="this.errorStateText"/>
        </div>
        <span t-if="this.props.thread.hasLoadingFailedError" class="o-xsmaller text-muted" t-out="window.String(this.props.thread.hasLoadingFailedError)"/>
        <button class="btn btn-link" t-on-click="this.onClickRetry">
            <i class="oi" data-icon="refresh"/>
            Try again
        </button>
    </div>
</t>

<!--
    @param {Number} counter
    @param {string} [badgeClass]
    @param {string} [iconClass]
    @param {boolean} [floating=false]
-->
<t t-name="mail.discuss_badge">
    <span class="badge rounded-pill o-discuss-badge flex-shrink-0 bg-inherit d-flex align-items-center justify-content-center" t-attf-class="{{ badgeClass }}" t-att-style="'margin: 0px; background-color: inherit !important;' + (floating ? 'padding: 1px;' : 'padding: 0px;')">
        <span class="rounded-pill o-innerBadge" t-attf-class="{{ counterClass }}" t-out="counter" style="top: 0 !important;"/>
    </span>
</t>

<t t-name="mail.Thread.startMessage">
    <div class="pt-4" t-att-class="{ 'px-3': this.env.inChatWindow, 'px-2': this.env.inDiscussApp or this.env.inMeetingChat }">
        <div class="d-flex gap-2 lh-sm" t-att-class="{
            'mt-2 mb-1': !this.channel?.parent_channel_id,
            'mt-1': this.channel?.parent_channel_id,
        }">
            <div class="o-mail-Thread-avatar" t-att-class="this.startMessageAvatarAttClass" t-ref="this.startMessageAvatarRef">
                <img t-if="!this.channel?.parent_channel_id" class="rounded-3 object-fit-cover" t-att-src="this.channel.avatarUrl" alt="Thread Image"/>
                <i t-else="" class="oi text-muted" data-icon="forum" role="presentation"/>
            </div>
            <div role="heading" aria-level="1" class="text-break" t-att-class="{ 'fs-1': !this.env.inChatWindow, 'fs-3': this.env.inChatWindow }" t-out="this.startMessageTitle"/>
        </div>
        <p class="text-muted mb-0 small text-break" t-out="this.startMessageSubtitle"/>
    </div>
</t>
</templates>
