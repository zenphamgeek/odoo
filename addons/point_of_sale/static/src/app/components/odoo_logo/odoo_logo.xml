<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="point_of_sale.OdooLogo">
        <div t-attf-class="{{ this.props.class }}" t-attf-style="{{ this.props.style }}">
            <img t-if="this.props.monochrome" src="/web/static/img/logo_dark.svg" alt="Insilos" style="max-height: 100%; max-width: 100%; object-fit: contain;"/>
            <img t-else="" src="/web/static/img/logo.svg" alt="Insilos" style="max-height: 100%; max-width: 100%; object-fit: contain;"/>
        </div>
    </t>
</templates>
