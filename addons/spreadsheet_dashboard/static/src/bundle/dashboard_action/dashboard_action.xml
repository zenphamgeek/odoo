<?xml version="1.0" encoding="utf-8"?>
<templates>
    <div t-name="spreadsheet_dashboard.DashboardAction" class="o_action o_spreadsheet_dashboard_action o_field_highlight">
        <t t-set="dashboard" t-value="this.loader.getActiveDashboard()"/>
        <ControlPanel display="this.controlPanelDisplay">
            <t t-set-slot="control-panel-actions" t-if="!this.loader.getActiveDashboard()?.isSample">
                <t t-set="status" t-value="this.loader.getActiveDashboard() and this.loader.getActiveDashboard().status"/>
                <div class="d-flex flex-wrap w-100">
                    <DashboardSearchBar t-if="status === this.Status.Loaded and this.loader.getActiveDashboard().model.getters.getGlobalFilters().length"
                                        t-key="this.activeDashboardId()"
                                        model="this.loader.getActiveDashboard().model"
                                        toggler="this.searchBarToggler"
                    />
                </div>
            </t>
            <t t-set-slot="control-panel-navigation-additional" t-if="!this.loader.getActiveDashboard()?.isSample">
                <!-- Dashboard selection -->
                <t t-if="this.uiService.isSmall">
                    <DashboardMobileSearchPanel
                        onDashboardSelected="(dashboardId) => this.openDashboard(dashboardId)"
                        activeDashboard="dashboard"
                        groups="this.getDashboardGroups()"/>
                </t>
                <SpreadsheetShareButton t-key="this.activeDashboardId()" model="this.loader.getActiveDashboard()?.model" onSpreadsheetShared.bind="this.shareSpreadsheet" togglerClass="'btn-light'"/>
                <a
                    t-if="this.loader.getActiveDashboard()"
                    title="Toggle favorite"
                    t-on-click="this.toggleFavorite"
                    t-attf-class="oi oi-lg o_dashboard_star align-middle lh-base {{this.loader.getActiveDashboard().data.is_favorite ? 'oi-filled' : ''}}"
                    data-icon="star"
                />
                <div class="ms-1 o_search_toggler" t-if="this.uiService.isSmall">
                    <t t-component="this.searchBarToggler.component" t-props="this.searchBarToggler.props"/>
                </div>
            </t>
        </ControlPanel>
        <div class="o_content o_component_with_search_panel" t-att-class="{ o_mobile_dashboard: this.uiService.isSmall }">
            <t t-if="!this.uiService.isSmall">
                <t t-if="this.state.sidebarExpanded">
                    <t t-call="spreadsheet_dashboard.DashboardAction.Expanded"/>
                    <div class="o_search_panel_resize h-100 px-1 opacity-0 opacity-100-hover"
                         t-on-click.stop.prevent=""
                         t-on-pointerdown.stop.prevent="this._onStartResize"
                         title="Kéo để điều chỉnh độ rộng menu">
                        <span class="border-start border-2 border-primary h-100 d-block"/>
                    </div>
                </t>
                <t t-else="" t-call="spreadsheet_dashboard.DashboardAction.Collapsed"/>
            </t>
            <!-- Main content -->
            <h3 t-if="!dashboard" class="dashboard-loading-status">No available dashboard</h3>
            <t t-else="">
                <t t-set="status" t-value="dashboard.status"/>
                <h3 t-if="status === this.Status.Loading" class="dashboard-loading-status">Loading...</h3>
                <div t-elif="status === this.Status.Error" class="dashboard-loading-status error">
                    An error occurred while loading the dashboard
                </div>
                <t t-else="">
                    <MobileFigureContainer t-if="this.uiService.isSmall" spreadsheetModel="dashboard.model" t-key="dashboard.data.id"/>
                    <div t-else="" class="o_renderer" t-att-class="{'o-sample-dashboard': dashboard.isSample}">
                        <SpreadsheetComponent
                            model="dashboard.model"
                            t-key="dashboard.data.id"/>
                    </div>
                </t>
            </t>
        </div>
    </div>

    <t t-name="spreadsheet_dashboard.DashboardAction.Collapsed">
        <div class="h-100 o_search_panel_sidebar mx-2 cursor-pointer d-flex flex-column align-items-center py-2" t-on-click="this.toggleSidebar" title="Mở menu Dashboard">
            <button title="Open sidebar" aria-label="Open sidebar" class="btn btn-light btn-sm d-flex p-2 mb-2">
                <i class="oi oi-lg oi-filled" data-icon="left_panel_open"/>
            </button>
            <div class="o_search_panel_current_selection text-truncate mt-3" t-if="this.loader.getActiveDashboard()">
                <span class="fw-bolder" t-out="this.activeDashboardGroupName"/>
                /
                <t t-out="this.loader.getActiveDashboard().data.name"/>
            </div>
        </div>
    </t>

    <t t-name="spreadsheet_dashboard.DashboardAction.Expanded">
        <div class="o_spreadsheet_dashboard_search_panel o_search_panel flex-grow-0 flex-shrink-0 h-100 d-flex flex-column"
             t-ref="this.sidebarRef">
            <div class="o_spreadsheet_dashboard_sidebar_header d-flex align-items-center justify-content-between px-3 py-2 border-bottom border-secondary border-opacity-10 flex-shrink-0">
                <div class="d-flex align-items-center gap-2 text-uppercase fw-bold fs-7 text-muted">
                    <i class="oi oi-view-dashboard text-primary"/>
                    <span>Dashboards</span>
                </div>
                <button title="Close sidebar" aria-label="Close sidebar"
                        t-if="!this.uiService.isSmall and this.loader.getActiveDashboard()"
                        class="btn btn-light btn-sm p-1 lh-1"
                        t-on-click="this.toggleSidebar">
                    <i class="oi oi-lg oi-filled" data-icon="left_panel_close"/>
                </button>
            </div>
            <div class="o_spreadsheet_dashboard_sidebar_content flex-grow-1 overflow-auto px-3 py-2">
                <section t-foreach="this.getDashboardGroups()" t-as="group" t-key="group.id" class="o_search_panel_section o_search_panel_category mb-3">
                    <header class="o_search_panel_section_header py-1 text-uppercase o_cursor_default user-select-none d-flex align-items-center gap-2">
                        <i class="oi oi-chevron-down fs-8 text-muted opacity-75"/>
                        <b class="fs-7 text-muted" t-out="group.name"/>
                    </header>
                    <ul class="list-group d-block o_search_panel_field ps-2">
                        <li t-foreach="group.dashboards" t-as="dashboard" t-key="dashboard.data.id"
                            t-on-click="() => this.openDashboard(dashboard.data.id)"
                            t-att-data-name="dashboard.data.name"
                            t-att-title="dashboard.data.name"
                            class="o_search_panel_category_value list-group-item cursor-pointer border-0 d-flex justify-content-between align-items-center px-2 py-1 my-1"
                            t-att-class="{'active': dashboard.data.id === this.loader.getActiveDashboard().data.id}">
                            <div class="o_dashboard_name text-truncate">
                                <t t-out="dashboard.data.name" />
                            </div>
                            <t t-set="comp" t-value="this.dashboardButton"/>
                            <t t-if="comp">
                                <t t-component="comp" t-props="{ dashboardId: dashboard.data.id, onClick: this.editDashboard.bind(this), data: dashboard.data }"/>
                            </t>
                        </li>
                    </ul>
                </section>
            </div>
        </div>
    </t>
</templates>
