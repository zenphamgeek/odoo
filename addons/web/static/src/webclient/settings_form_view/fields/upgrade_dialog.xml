<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="web.UpgradeDialog">
        <Dialog title.translate="Insilos Enterprise">
            <div role="status"
                class="d-flex flex-row align-items-center flex-wrap  flex-md-nowrap gap-1">
                <div class="w-100 w-md-50">
                    Get this feature and much more with Insilos Enterprise!
                    <ul class="list-unstyled">
                        <li><i class="oi" data-icon="check"></i> Access to all Enterprise Apps</li>
                        <li><i class="oi" data-icon="check"></i> New design</li>
                        <li><i class="oi" data-icon="check"></i> Mobile support</li>
                        <li><i class="oi" data-icon="check"></i> Upgrade to future versions</li>
                        <li><i class="oi" data-icon="check"></i> Bugfixes guarantee</li>
                        <li><a href="https://insilos.com" target="_blank"><i class="oi" data-icon="add"></i> And more</a></li>
                    </ul>
                </div>
                <div class="o_video_embed w-100 w-md-50 ratio ratio-16x9 d-flex align-items-center justify-content-center bg-light rounded border text-muted">
                    <div class="text-center p-3">
                        <i class="oi oi-large mb-2" data-icon="star"/>
                        <div class="fw-bold">Insilos Enterprise</div>
                        <small>Unlock premium enterprise apps and features</small>
                    </div>
                </div>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="this._confirmUpgrade">Upgrade now</button>
                <button class="btn btn-secondary" t-on-click="this.props.close">Discard</button>
            </t>
        </Dialog>
    </t>
</templates>
