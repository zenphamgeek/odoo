<?xml version="1.0" encoding="utf-8"?>
<template>
    <div t-name='res_config_edition'>
        <Setting addLabel="false">
                <div class="user-heading">
                    <h3 class="px-0">
                        Insilos <t t-out="this.serverVersion"/>
                        (Community Edition)
                    </h3>
                    <t t-if="this.serverBuildId">
                        <div class="text-muted small mb-1 o_insilos_build_info" style="font-family: monospace;">
                            Build <t t-out="this.serverBuildId"/> • Worktree <t t-out="this.serverBuildDatetime"/> • Tag <t t-out="this.serverBuildTag"/>
                        </div>
                    </t>
                </div>
                <div>
                    <div class="tab-content">
                        <div role="tabpanel" id="settings" class="tab-pane active text-muted o_web_settings_compact_subtitle">
                            <small>Copyright © 2004 <a target="_blank" href="https://insilos.com" style="text-decoration: underline;">Insilos</a> <a id="license" target="_blank" href="http://www.gnu.org/licenses/lgpl.html" style="text-decoration: underline;">GNU LGPL Licensed</a></small>
                        </div>
                    </div>
                </div>
        </Setting>
    </div>
</template>
