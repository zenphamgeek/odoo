<?xml version="1.0" encoding="utf-8"?>
<data>

    <!-- Call this template instead of "web.assets_tests" to have the proper conditional check -->
    <template id="conditional_assets_tests" name="Tests Assets Bundle">
        <t t-if="'tests' in debug or test_mode_enabled">
            <t t-if="ignore_missing_deps">
                <!-- FIXME: This is only to ignore the errors for the lazy loading. To allow all tests assets and tours to be in the same bundle, the assets_tests bundle ignores missing dependencies -->
                <t t-call-assets="web.__assets_tests_call__" defer_load="True" />
            </t>
            <t t-else="">
                <t t-call-assets="web.assets_tests" defer_load="True" />
            </t>
        </t>
    </template>

    <template id="web.layout" name="Web layout">&lt;!DOCTYPE html&gt;
<html t-att="html_data or {}">
    <head>
        <meta charset="utf-8"/>
        <meta http-equiv="X-UA-Compatible" content="IE=edge"/>
        <title t-out="title or 'Insilos'"/>
        <link type="image/x-icon" rel="shortcut icon" t-att-href="x_icon or '/web/static/img/favicon.ico'"/>
        <script id="web.layout.odooscript" type="text/javascript">
            var insilos = {
                csrf_token: "<t t-out="request.csrf_token(None)"/>",
                debug: "<t t-out="debug"/>",
            };
            window[String.fromCharCode(111,100,111,111)] = insilos;
        </script>
        <t t-out="head"/>
    </head>
    <body t-att-class="body_classname">
        <t t-out="0"/>
    </body>
</html>
    </template>

    <template id="web.frontend_layout" name="Frontend Layout" inherit_id="web.layout" primary="True">
      <xpath expr="//head/meta[last()]" position="after">
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
      </xpath>
      <xpath expr="//head/link[last()]" position="after">
        <t t-call-assets="web.material_symbols_outlined" t-binary="True"/>
        <t t-call-assets="web.odoo_ui_icons" t-binary="True"/>
        <t t-call-assets="web.phosphor_icons" t-binary="True"/>
        <t t-call-assets="web.assets_frontend" t-js="false"/>
      </xpath>
      <xpath expr="//head/script[@id='web.layout.odooscript']" position="after">
        <script type="text/javascript">
            insilos.__session_info__ = <t t-out="json.dumps({**env['ir.http'].get_frontend_session_info(), **(extra_session_info or {})})"/>;
            if (!/(^|;\s)tz=/.test(document.cookie)) {
                const userTZ = Intl.DateTimeFormat().resolvedOptions().timeZone;
                document.cookie = `tz=${userTZ}; path=/`;
            }
        </script>
        <t t-call-assets="web.assets_frontend_minimal" t-css="false" defer_load="True"/>
        <t t-call="web.conditional_assets_tests" ignore_missing_deps="True"/>
        <t t-call-assets="web.assets_frontend_lazy" t-css="false" lazy_load="True"/>
      </xpath>
        <xpath expr="//t[@t-out='0']" position="replace">
            <div id="wrapwrap" t-attf-class="#{pageName or ''}">
                <header t-if="not no_header" id="top" data-anchor="true">
                    <img class="img-responsive d-block mx-auto"
                        t-attf-src="/web/binary/company_logo"
                        alt="Logo"/>
                </header>
                <main>
                    <t t-out="0"/>
                </main>
                <footer t-if="not no_footer" id="bottom" data-anchor="true" t-attf-class="bg-light o_footer">
                    <div id="footer"/>
                    <div t-if="not no_copyright" class="o_footer_copyright">
                        <div class="container py-3">
                            <div class="row row-gap-2">
                                <div name="footer_copyright_col" class="col-md text-center text-sm-start text-muted">
                                    <span class="o_footer_copyright_name">Copyright &amp;copy; <span t-field="res_company.name" itemprop="name">Company name</span></span>
                                    <t id="language_selector_hook"/>
                                </div>
                                <div class="col-md text-center text-sm-end">
                                    <t t-call="web.brand_promotion"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </footer>
            </div>
        </xpath>
    </template>

    <template id="brand_promotion_message" name="Brand Promotion Message">
        <t t-set="insilos_logo">
            <strong>
                <a target="_blank"
                    t-attf-href="https://insilos.com?utm_source=db&amp;utm_medium=#{_utm_medium}">
                    Insilos
                </a>
            </strong>
        </t>
        <t t-set="final_message">Powered by %s%s</t>
        <t t-out="final_message % (insilos_logo, _message and ('- ' + _message) or '')"/>
    </template>
    <template id="brand_promotion" name="Brand Promotion">
        <div class="o_brand_promotion">
            <t t-call="web.brand_promotion_message" _message.translate="" _utm_medium.f="portal"/>
        </div>
    </template>

    <template id="web.login_layout" name="Login Layout">
        <t t-set="head">
            <t t-out="head"/>
        </t>
        <t t-call="web.frontend_layout"
            html_data="{'style': 'height: 100%;'}"
            body_classname.f="insilos_auth_body"
            no_header="True"
            no_footer="True"
            head="head">

            <div class="insilos_auth_portal_wrapper d-flex align-items-center justify-content-center">
                <div t-attf-class="insilos_auth_portal_card d-flex overflow-hidden {{login_card_classes}} o_database_list">
                    <!-- Left Column: Enterprise Hero Showcase (58%) -->
                    <div class="insilos_auth_hero_showcase d-flex flex-column justify-content-between p-4 p-lg-5 text-white">
                        <t t-call="web.login_hero_content"/>
                    </div>

                    <!-- Right Column: Authentication Form Pane (42%) -->
                    <div class="insilos_auth_form_pane p-4 p-lg-5">
                        <div class="auth_form_header mb-4">
                            <div class="d-lg-none mb-3 text-center">
                                <img src="/web/static/img/insilos_logo.svg" alt="Insilos" style="height: 32px; width: auto;"/>
                            </div>
                            <t t-if="'signup' in request.httprequest.path">
                                <h3 class="auth_title mb-1">Đăng Ký Tài Khoản</h3>
                                <p class="auth_subtitle mb-0">Tạo thông tin định danh mới trên hệ thống Insilos Enterprise</p>
                            </t>
                            <t t-elif="'reset_password' in request.httprequest.path">
                                <h3 class="auth_title mb-1">Đặt Lại Mật Khẩu</h3>
                                <p class="auth_subtitle mb-0">Nhập địa chỉ email tài khoản để nhận liên kết xác thực đặt lại mật khẩu</p>
                            </t>
                            <t t-else="">
                                <h3 class="auth_title mb-1">Đăng Nhập Hệ Thống</h3>
                                <p class="auth_subtitle mb-0">Vui lòng nhập thông tin xác thực để truy cập hệ thống</p>
                            </t>
                        </div>

                        <div class="auth_form_body">
                            <t t-out="0"/>
                        </div>

                        <div class="auth_footer_block mt-4 pt-3 border-top d-flex flex-wrap justify-content-between align-items-center small" t-if="not disable_footer">
                            <t t-if="not disable_database_manager">
                                <div t-if="databases and len(databases) &gt; 1" class="dropdown dropup">
                                    <button type="button" id="insilosDbSelectorDropdown" class="btn btn-sm dropdown-toggle d-inline-flex align-items-center gap-1.5 py-0.5 px-2.5 rounded-pill shadow-none border" data-bs-toggle="dropdown" aria-expanded="false" style="font-size: 11.5px; height: 26px; line-height: 24px; background: #f8fafc; color: #334155; border-color: #e2e8f0;">
                                        <i class="oi oi-fw me-0.5" data-icon="database" style="font-size: 11px; color: #0F62FE;"></i>
                                        <span style="font-size: 11px; color: #64748B;">Cơ sở dữ liệu:</span>
                                        <span class="font-monospace fw-bold" style="font-size: 11px; color: #0F172A;"><t t-out="request.db"/></span>
                                    </button>
                                    <ul class="dropdown-menu shadow-sm border py-1 mb-1" style="font-size: 12px; min-width: 210px; border-color: #e2e8f0;">
                                        <li class="dropdown-header text-uppercase text-muted py-1" style="font-size: 10px; letter-spacing: 0.05em; font-weight: 600;">Chọn cơ sở dữ liệu</li>
                                        <t t-foreach="databases" t-as="d">
                                            <li>
                                                <a t-attf-href="/web/login?db=#{d}" t-attf-class="dropdown-item d-flex align-items-center justify-content-between py-1.5 px-3 {{ 'active fw-semibold' if d == request.db else '' }}">
                                                    <span class="font-monospace"><t t-out="d"/></span>
                                                    <i t-if="d == request.db" class="oi oi-fw ms-2" data-icon="check" style="font-size: 11px;"></i>
                                                </a>
                                            </li>
                                        </t>
                                        <li class="dropdown-divider my-1"></li>
                                        <li>
                                            <a href="/web/database/manager" class="dropdown-item py-1.5 px-3 text-muted small d-flex align-items-center gap-1.5">
                                                <i class="oi oi-fw" data-icon="settings" style="font-size: 11px;"></i>
                                                <span>Quản trị cơ sở dữ liệu...</span>
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                                <a t-elif="request.db" class="auth_meta_link d-inline-flex align-items-center gap-1.5 py-0.5 px-2.5 rounded-pill border" href="/web/database/manager" style="font-size: 11.5px; height: 26px; line-height: 24px; background: #f8fafc; color: #334155; border-color: #e2e8f0; text-decoration: none;">
                                    <i class="oi oi-fw me-0.5" data-icon="database" style="font-size: 11px; color: #0F62FE;"></i>
                                    <span style="font-size: 11px; color: #64748B;">Cơ sở dữ liệu:</span>
                                    <span class="font-monospace fw-bold" style="font-size: 11px; color: #0F172A;"><t t-out="request.db"/></span>
                                </a>
                                <a t-else="" class="auth_meta_link" href="/web/database/manager">
                                    <i class="oi oi-fw me-1" data-icon="database"></i>Quản trị cơ sở dữ liệu
                                </a>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="web.login" name="Login">
        <t t-set="head">
            <t t-if="disable_opengraph">
                <!-- Open Graph / Facebook -->
                <meta property="og:site_name" content="Insilos"/>
                <meta property="og:type" content="website"/>
                <meta property="og:url" t-att-content="og_url"/>
                <meta property="og:title" t-att-content="og_title"/>
                <meta property="og:description" content="All your business on one platform. Simple, efficient, yet affordable!"/>
                <meta property="og:image" t-att-content="og_image_url"/>
                <meta property="og:image:alt" content="All your business on one platform. Simple, efficient, yet affordable!"/>
                <meta property="og:image:width" content="747"/>
                <meta property="og:image:height" content="420"/>
                <!-- Twitter -->
                <meta name="twitter:card" content="summary_large_image"/>
                <meta name="twitter:site" content="@Insilos"/>
                <meta name="twitter:url" t-att-content="og_url"/>
                <meta name="twitter:domain" t-att-content="og_domain"/>
                <meta name="twitter:title" t-att-content="og_title"/>
                <meta name="twitter:description" content="All your business on one platform. Simple, efficient, yet affordable!"/>
                <meta name="twitter:image" t-att-content="og_image_url"/>
                <meta name="twitter:image:alt" content="All your business on one platform. Simple, efficient, yet affordable!"/>
            </t>
        </t>
        <t t-call="web.login_layout" head="head">
            <h1 class="visually-hidden">Login</h1>
            <div class="oe_structure" id="oe_structure_login_top"/>
            <owl-component t-if="not login" name="web.user_switch" />
            <form class="oe_login_form" role="form" t-attf-action="/web/login" method="post" onsubmit="this.action = '/web/login' + location.hash" data-captcha="login">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                <input type="hidden" name="db" t-att-value="request.db" id="db"/>

                <div class="mb-3 field-login">
                    <label for="login" class="form-label d-flex justify-content-between">Tài khoản / Email</label>
                    <input type="text" placeholder="Nhập email hoặc tên đăng nhập" name="login" t-att-value="login" id="login" class="form-control" required="required" autocapitalize="off" autocomplete="username"/>
                </div>

                <div class="o_caps_lock_warning">
                    <div class="d-flex justify-content-between align-items-start">
                        <label for="password" class="form-label">Mật khẩu</label>
                    </div>
                    <div class="input-group mb-1">
                        <input type="password" placeholder="Nhập mật khẩu" name="password" id="password" class="form-control" required="required" autocomplete="current-password" t-att-autofocus="'autofocus' if login else None" maxlength="4096"/>
                        <button type="button" class="btn btn-sm border border-start-0 o_show_password">
                            <i class="oi" data-icon="visibility"/>
                        </button>
                    </div>
                </div>

                <p class="alert alert-danger" t-if="error" role="alert">
                    <t t-out="error"/>
                </p>
                <p class="alert alert-success" t-if="message" role="status">
                    <t t-out="message"/>
                </p>

                <div class="oe_login_buttons text-center d-grid mb-1 pt-3">
                    <button type="submit" class="btn btn-primary">Đăng nhập</button>
                    <t t-if="debug">
                        <button type="submit" name="redirect" value="/web/become" class="btn btn-link btn-sm">Đăng nhập quản trị viên (Superuser)</button>
                    </t>
                    <t t-call="web.login_oauth"/>
                </div>

                <input type="hidden" name="type" value="password"/>
                <input type="hidden" name="redirect" t-att-value="redirect"/>
            </form>
            <div class="oe_structure" id="oe_structure_login_bottom"/>
        </t>
    </template>

    <template id="web.login_successful" name="Login successful">
        <t t-call="web.login_layout">
            <div class="oe_login_form text-center py-3">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle p-3 mb-3" style="background: rgba(16, 185, 129, 0.12); width: 64px; height: 64px;">
                    <i class="oi oi-fw text-success" data-icon="check" style="font-size: 28px;"></i>
                </div>
                <h4 class="fw-bold mb-1">Đăng Nhập Thành Công</h4>
                <p class="text-muted small mb-4">
                    Phiên làm việc bảo mật đã được thiết lập trên hệ thống Insilos.
                </p>
                <div t-attf-class="clearfix oe_login_buttons text-center mb-1 pt-2 d-flex justify-content-center gap-2">
                    <form method="POST" action="/web/session/logout" class="text-center d-inline-block">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <button type="submit" class="btn btn-secondary rounded-pill px-4">
                            Đăng xuất
                        </button>
                    </form>
                    <a href="/web" class="btn btn-primary rounded-pill px-4">
                        Vào hệ thống làm việc
                    </a>
                </div>
            </div>
        </t>
    </template>

    <template id="web.login_oauth" name="Login OAuth">
        <!-- Use auth_btns to insert login options displayed under the
        login form -->
        <t t-set="auth_btns" t-value="[]"/>
        <div t-if="auth_btns" class="o_login_auth">
            <em class="d-block my-3 small text-center text-muted">- or -</em>
            <div class="list-group">
                <a t-foreach="auth_btns" t-as="p" t-attf-class="{{p.get('list_item_class')}} list-group-item list-group-item-action d-flex align-items-center gap-2 py-2" t-att-href="p.get('auth_link') or '#'">
                    <i t-att-class="p['css_class']" t-att-data-icon="p.get('icon') or 'login'" role="presentation"/>
                    <span class="mx-auto" t-out="p['body']"/>
                </a>
            </div>
        </div>
    </template>

    <template id="web.check_identity" name="Check Identity">
        <t t-call="web.login_layout">
            <div class="oe_check_identity_form">
                <div class="text-center">
                    <img t-attf-src="/logo.png?company={{ env.company.id }}" style="padding: 0px; margin: 0px; height: auto; height: 48px;" t-att-alt="env.company.name"/>
                    <h3>Confirm access</h3>
                </div>
                <owl-component name="web.check_identity_form" t-att-props="json.dumps({'redirect': redirect})"/>
            </div>
        </t>
    </template>

    <template id="web.unit_tests_suite">
        <t t-set="head">
            <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no"/>

            <script type="text/javascript">
                insilos.__session_info__ = <t t-out="json.dumps(session_info)"/>;
            </script>

            <t t-call-assets="web.assets_unit_tests_setup" />
            <t t-call-assets="web.assets_unit_tests" defer_load="True" />
        </t>
        <t t-call="web.layout"
            html_data="{'style': 'height: 100%;'}"
            title.translate="Web Unit Tests"
            head="head"/>
    </template>

    <template id="web.webclient_bootstrap">
        <t t-set="head">
            <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no"/>
            <meta name="theme-color" content="#070B14"/>
            <link rel="manifest" href="/web/manifest.webmanifest" crossorigin="use-credentials"/>
            <link rel="apple-touch-icon" href="/web/static/img/insilos-icon-ios.png"/>
            <script type="text/javascript">
                // Block to avoid leaking variables in the script scope
                {
                    insilos.__session_info__ = <t t-out="json.dumps(session_info)"/>;
                    const { user_context } = insilos.__session_info__;
                    const lang = new URLSearchParams(document.location.search).get("lang");
                    let menuURL = "/web/webclient/load_menus";
                    if (lang) {
                        user_context.lang = lang;
                        menuURL += `&amp;lang=${lang}`;
                    }
                    insilos.reloadMenus = () =&gt; fetch(menuURL, { cache: "no-store" }).then(res =&gt; res.json());
                    insilos.loadMenusPromise = insilos.reloadMenus();
                }
            </script>
            <t t-call-assets="web.assets_web_print" media="print" t-js="false"/>
            <t t-call-assets="web.assets_web" t-css="false"/>

            <t t-if="color_scheme == 'dark'">
                <t t-call-assets="web.assets_web_dark" media="screen" t-js="false"/>
            </t>
            <t t-else="">
                <t t-call-assets="web.assets_web" media="screen" t-js="false"/>
            </t>
            <t t-call="web.conditional_assets_tests"/>
            <t t-out="head"/>
        </t>
        <t t-call="web.layout"
            head="head"
            body_classname.f="o_web_client"/>
    </template>

    <template id="webclient_offline">
        <t t-set="head">
            <script type="text/javascript">
                document.addEventListener("DOMContentLoaded", () =&gt; {
                    const cookies = document.cookie.split(';').map(c =&gt; c.trim());
                    if (cookies.includes('color_scheme=dark')) {
                        document.body.style.backgroundColor = "#262A36";
                        document.body.style.color = "#FFFFFF";
                    }
                });
                window.addEventListener('online', () =&gt; location.reload());
            </script>
            <style>
                body {
                font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Ubuntu, "Noto Sans", Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji";
                padding:0;
                margin:0;
                background-color: #fff;
                color: rgb(17, 24, 39);
                display: flex;
                align-items: center;
                justify-content: center;
                text-align: center;
                height: 100vh;
                width: 100vw;
                user-select: none;
                }
                .card {
                width: 80%;
                }
                .card img {
                width: 96px;
                height: auto;
                filter: grayscale(.6);
                }
                .card button {
                background-color: #FF8000;
                color: #FFFFFF;
                border: 1px solid #FF8000;
                border-radius: .25rem;
                padding: .5rem 1rem;
                cursor: pointer;
                font-size: 1.2rem;
                font-weight: 500;
                }
            </style>
            <meta name="viewport" content="width=device-width, initial-scale=1"/>
        </t>
        <t t-call="web.layout"
            html_data="{'style': 'height: 100%;'}"
            title.translate="Offline"
            head="head">
            <div class="card">
                <img t-attf-src="data:image/png;base64,{{odoo_icon.to_base64()}}" alt="Insilos logo"/>
                <h1>You are offline</h1>
                <p>Check your network connection and come back here. Insilos will load as soon as you're back online.</p>
                <button onclick="location.reload()">Check again</button>
            </div>
        </t>
    </template>

    <template id="webclient_scoped_app">
        <t t-set="x_icon" t-value="'/scoped_app_icon_png?app_id=%s' % (app_id)" />
        <t t-set="head">
            <t t-call-assets="web.assets_frontend_minimal"/>
            <t t-call-assets="web.assets_frontend_lazy"/>
            <link rel="apple-touch-icon" t-att-href="x_icon"/>
            <link rel="manifest" t-att-href="safe_manifest_url" crossorigin="use-credentials" />
            <meta name="viewport" content="width=device-width, initial-scale=1"/>
        </t>
        <t t-call="web.layout"
            html_data="{'style': 'height: 100%;'}"
            title="'Install %s' % (app_name)"
            x_icon="x_icon"
            head="head">
            <owl-component name="web.install_scoped_app" />
        </t>
    </template>
</data>
